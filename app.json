{
  "pages": [
    "pages/today/today",
    "pages/library/library",
    "pages/index/index",
    "pages/nutrition/nutrition",
    "pages/me/me",
    "pages/record/record",
    "pages/history/history",
    "pages/stats/stats",
    "pages/fatloss/fatloss",
    "pages/history/day",
    "pages/weight/weight",
    "pages/welcome/welcome",
    "pages/backup/backup",
    "pages/exercise-progress/progress",
    "pages/report/report",
    "pages/schedule/schedule",
    "pages/reminders/reminders"
  ],
  "window": {
    "backgroundTextStyle": "dark",
    "navigationBarBackgroundColor": "#F6F4EE",
    "navigationBarTitleText": "健行计划",
    "navigationBarTextStyle": "black",
    "navigationStyle": "custom",
    "backgroundColor": "#F6F4EE"
  },
  "tabBar": {
    "custom": true,
    "color": "#5D6366",
    "selectedColor": "#111517",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/today/today",
        "text": "今天",
        "iconPath": "images/tab-today.png",
        "selectedIconPath": "images/tab-today-active.png"
      },
      {
        "pagePath": "pages/library/library",
        "text": "动作库",
        "iconPath": "images/tab-library.png",
        "selectedIconPath": "images/tab-library-active.png"
      },
      {
        "pagePath": "pages/index/index",
        "text": "计划",
        "iconPath": "images/tab-plan.png",
        "selectedIconPath": "images/tab-plan-active.png"
      },
      {
        "pagePath": "pages/nutrition/nutrition",
        "text": "饮食",
        "iconPath": "images/tab-diet.png",
        "selectedIconPath": "images/tab-diet-active.png"
      },
      {
        "pagePath": "pages/me/me",
        "text": "我的",
        "iconPath": "images/tab-me.png",
        "selectedIconPath": "images/tab-me-active.png"
      }
    ]
  },
  "subpackages": [
    {
      "root": "packageExercise",
      "pages": [
        "pages/library/library",
        "pages/detail/detail"
      ]
    }
  ],
  "preloadRule": {
    "pages/index/index": {
      "network": "all",
      "packages": [
        "packageExercise"
      ]
    }
  },
  "sitemapLocation": "sitemap.json",
  "style": "v2",
  "usingComponents": {
    "nav-bar": "/components/nav-bar/nav-bar"
  }
}
