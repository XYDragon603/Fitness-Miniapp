.tabbar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 999; display: flex; background: #FFFFFF; padding: 12rpx 8rpx calc(env(safe-area-inset-bottom) + 6rpx); border-top: 1rpx solid #ECEAE4; }
.tabbar-item { flex: 1; min-width: 0; height: 104rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6rpx; }
.tabbar-item:active { opacity: 0.7; }
.tabbar-icon { width: 50rpx; height: 50rpx; }
.tabbar-label { font-size: 22rpx; line-height: 1.2; color: #5D6366; font-weight: 500; }
.tabbar-item.active .tabbar-label { color: #111517; font-weight: 800; }
