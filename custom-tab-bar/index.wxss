.tabbar-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  pointer-events: none;
  padding: 0 16rpx calc(env(safe-area-inset-bottom) + 16rpx);
  background: linear-gradient(180deg, rgba(244, 248, 247, 0) 0%, rgba(244, 248, 247, 0.92) 26%, rgba(244, 248, 247, 1) 100%);
}

.tabbar-panel {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  min-height: 132rpx;
  padding: 14rpx 10rpx 10rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(217, 232, 228, 0.94);
  box-shadow: 0 14rpx 34rpx rgba(52, 92, 89, 0.14);
  pointer-events: auto;
}

.tabbar-item {
  position: relative;
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border-radius: 22rpx;
  padding: 10rpx 4rpx 14rpx;
  transition: transform 0.22s ease, background 0.22s ease, box-shadow 0.22s ease;
}

.tabbar-item:active {
  transform: scale(0.97);
}

.tabbar-item.active {
  background: linear-gradient(180deg, rgba(201, 101, 101, 0.08), rgba(201, 101, 101, 0.02));
  transform: translateY(-2rpx);
  box-shadow: inset 0 0 0 1rpx rgba(201, 101, 101, 0.12);
}

.tabbar-icon {
  width: 46rpx;
  height: 46rpx;
  transition: transform 0.22s ease, opacity 0.22s ease;
}

.tabbar-label {
  font-size: 23rpx;
  line-height: 1.25;
  color: #64727D;
  font-weight: 600;
  transition: color 0.22s ease, transform 0.22s ease;
}

.tabbar-item.active .tabbar-icon {
  transform: scale(1.08);
}

.tabbar-item.active .tabbar-label {
  color: #C96565;
  font-weight: 700;
  transform: translateY(1rpx);
}

.tabbar-indicator {
  position: absolute;
  bottom: 4rpx;
  width: 34rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: #C96565;
}
