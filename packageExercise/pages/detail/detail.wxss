.detail-head { text-align: center; margin: -8rpx 0 26rpx; }
.detail-name { font-size: 54rpx; font-weight: 800; }
.detail-name-en { margin-top: 4rpx; font-size: 24rpx; letter-spacing: 4rpx; color: var(--text-2); }

.demo { padding: 26rpx 28rpx 0; }
.demo-label { display: block; }
.demo-media { display: block; width: 100%; height: 400rpx; margin: 8rpx 0 12rpx; }
.demo-gif-wrap { position: relative; display: flex; flex-direction: column; align-items: center; gap: 10rpx; margin: 14rpx 0 22rpx; }
.demo-gif { width: 420rpx; height: 420rpx; }
.demo-credit { font-size: 20rpx; color: var(--dark-text-3); }
.demo-facts { display: flex; align-items: center; border-top: 2rpx solid var(--dark-line); margin: 0 -28rpx; padding: 22rpx 20rpx; }
.demo-fact { flex: 1; display: flex; align-items: center; justify-content: center; gap: 12rpx; font-size: 28rpx; font-weight: 700; color: #FFFFFF; }
.demo-fact-icon { width: 32rpx; height: 56rpx; }
.demo-sep { width: 2rpx; height: 40rpx; background: var(--dark-line); }

.mark-title { display: flex; align-items: center; gap: 14rpx; margin: 40rpx 0 20rpx; font-size: 36rpx; font-weight: 800; }
.mark-title::before { content: ''; width: 8rpx; height: 34rpx; border-radius: 4rpx; background: var(--lime); }

.muscles { display: flex; gap: 14rpx; }
.muscle-card { flex: 1; min-width: 0; display: flex; padding: 22rpx 14rpx 22rpx 22rpx; border-radius: 22rpx; background: var(--surface-2); }
.muscle-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.muscle-kind { font-size: 22rpx; color: var(--text-2); }
.muscle-name { font-size: 36rpx; font-weight: 800; }
.muscle-desc { font-size: 22rpx; color: var(--text-2); line-height: 1.5; }
.muscle-figure { width: 110rpx; height: 190rpx; flex-shrink: 0; }

.steps { background: var(--surface); border-radius: 22rpx; padding: 6rpx 24rpx; }
.step { display: flex; gap: 22rpx; padding: 24rpx 0; }
.step + .step { border-top: 2rpx solid var(--line); }
.step-no { width: 52rpx; height: 52rpx; border-radius: 50%; background: var(--ink); color: #FFFFFF; font-size: 26rpx; font-weight: 800; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.step-text { flex: 1; font-size: 28rpx; line-height: 1.65; color: var(--text); padding-top: 4rpx; }
.step-text.muted { color: var(--text-2); padding: 24rpx 0; }
