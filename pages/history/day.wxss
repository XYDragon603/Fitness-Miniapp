.day-title { font-size: 64rpx; }
.day-sub { margin-top: 10rpx; font-size: 32rpx; font-weight: 700; color: var(--text-2); }
.day-done { color: #7DB928; }

.day-stats { display: flex; padding: 30rpx 32rpx; }
.day-stat { position: relative; flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.day-stat + .day-stat { padding-left: 32rpx; border-left: 2rpx solid var(--dark-line); }
.day-stat-value { font-size: 86rpx; line-height: 1.1; font-weight: 800; letter-spacing: -2rpx; }
.day-stat-unit { font-size: 32rpx; letter-spacing: 0; }

.day-ex { margin-bottom: 24rpx; }
.day-ex-head { display: flex; align-items: center; gap: 20rpx; padding: 8rpx 0 16rpx; }
.day-ex-no { width: 56rpx; height: 56rpx; border-radius: 50%; background: var(--surface-2); display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: 800; flex-shrink: 0; }
.day-ex-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2rpx; }
.day-ex-name { font-size: 34rpx; font-weight: 800; }
.day-ex-meta { font-size: 24rpx; color: var(--text-2); }
.day-pr { gap: 6rpx; height: 48rpx; padding: 0 16rpx; border-radius: 24rpx; font-size: 23rpx; font-weight: 800; }
.day-sets { margin-left: 76rpx; padding: 6rpx 24rpx; background: var(--surface); border-radius: 18rpx; }
.day-set { display: flex; align-items: center; gap: 16rpx; padding: 14rpx 0; }
.day-set + .day-set { border-top: 2rpx solid var(--line); }
.day-set-label { width: 140rpx; font-size: 25rpx; color: var(--text-2); }
.day-set-value { font-size: 28rpx; font-weight: 700; }
.day-set-value.muted { color: var(--text-3); font-weight: 400; }
.day-foot { display: flex; align-items: center; justify-content: center; gap: 20rpx; margin: 36rpx 0 8rpx; font-size: 24rpx; color: var(--text-3); }
.day-foot::before, .day-foot::after { content: ''; width: 80rpx; height: 2rpx; background: var(--line); }

.day-rest { min-height: 260rpx; }
.day-rest-feeling { position: relative; margin-top: 8rpx; font-size: 60rpx; font-weight: 800; }
.day-rest-note { position: relative; width: 70%; margin-top: 12rpx; font-size: 28rpx; color: #D6DBDD; line-height: 1.6; }
.day-rest-moon { position: absolute; right: 40rpx; top: 40rpx; width: 120rpx; height: 120rpx; }

.day-delete { margin: 48rpx 0 16rpx; text-align: center; font-size: 26rpx; color: var(--danger); }
