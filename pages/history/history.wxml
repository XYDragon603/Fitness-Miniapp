<nav-bar back />
<view class="page history">
  <view class="hero history-hero"><view class="hero-title">历史记录</view></view>

  <view class="tabs">
    <view class="tabs-item {{tab === 'training' ? 'active' : ''}}" bindtap="switchTab" data-tab="training">训练记录</view>
    <view class="tabs-item {{tab === 'nutrition' ? 'active' : ''}}" bindtap="switchTab" data-tab="nutrition">饮食记录</view>
  </view>

  <!-- ========== 训练日历 ========== -->
  <block wx:if="{{tab === 'training'}}">
    <view class="cal-head">
      <image class="cal-arrow" src="/images/icons/chevron-left-ink.svg" bindtap="switchMonth" data-delta="-1" />
      <text class="cal-title">{{calendar.title}}</text>
      <image class="cal-arrow" src="/images/icons/chevron-right-ink.svg" bindtap="switchMonth" data-delta="1" />
    </view>
    <view class="cal-week">
      <text wx:for="{{['一', '二', '三', '四', '五', '六', '日']}}" wx:key="*this">{{item}}</text>
    </view>
    <view class="cal-row" wx:for="{{calendar.weeks}}" wx:for-item="week" wx:key="index">
      <view
        wx:for="{{week}}" wx:key="date"
        class="cal-cell {{item.inMonth ? '' : 'out'}} {{item.isToday ? 'today' : ''}}"
        bindtap="selectCalendarDay" data-date="{{item.date}}"
      >
        <text class="cal-day num">{{item.day}}</text>
        <view wx:if="{{item.type === 'training'}}" class="cal-dot"></view>
        <image wx:elif="{{item.type === 'rest'}}" class="cal-moon" src="/images/icons/moon-{{item.isToday ? 'white' : 'ink'}}.svg" />
        <view wx:else class="cal-none"></view>
      </view>
    </view>
    <view class="cal-legend">
      <view class="cal-legend-item"><view class="cal-dot"></view>训练</view>
      <view class="cal-legend-sep"></view>
      <view class="cal-legend-item"><image class="cal-moon" src="/images/icons/moon-ink.svg" />休息</view>
    </view>

    <view class="section-head"><text class="section-title">近期记录</text></view>
    <view class="recent" wx:for="{{recent}}" wx:key="date" bindtap="openDay" data-date="{{item.date}}">
      <view class="recent-date"><text class="recent-day">{{item.title}}</text><text class="recent-week">{{item.weekday}}</text></view>
      <view class="recent-sep"></view>
      <image class="recent-icon" src="/images/icons/{{item.isRest ? 'moon-ink' : 'dumbbell-lime'}}.svg" />
      <view class="recent-copy"><text class="recent-name">{{item.name}}</text><text class="recent-status">{{item.status}}</text></view>
      <image class="chevron" src="/images/icons/chevron-right-grey.svg" />
    </view>
    <view class="empty" wx:if="{{recent.length === 0}}">
      <view class="empty-figure"><image class="icon-lg" src="/images/icons/calendar-ink.svg" /></view>
      <view class="empty-title">还没有训练记录</view>
      <view class="empty-text">完成第一次训练后，会在日历上留下标记。</view>
    </view>
  </block>

  <!-- ========== 饮食记录 ========== -->
  <block wx:else>
    <picker mode="date" value="{{nutritionDate}}" end="{{today}}" bindchange="onNutritionDateChange">
      <view class="date-pick">
        <image class="icon" src="/images/icons/calendar-ink.svg" />
        <text class="date-pick-text">{{nutritionDateLabel}}</text>
        <image class="icon" src="/images/icons/chevron-down-ink.svg" />
      </view>
    </picker>

    <view class="dark-card n-total">
      <view class="n-total-top">
        <view>
          <text class="label-dark n-total-label">{{nutritionDate === today ? '今日总摄入' : '当日总摄入'}}</text>
          <view class="n-total-value num">{{nutritionTotal.calories}}<text class="n-total-unit"> kcal</text></view>
        </view>
        <view class="n-ring" wx:if="{{nutritionTotal.hasTarget}}">
          <image class="n-ring-img" src="{{nutritionRing}}" />
          <view class="n-ring-center"><image class="icon" src="/images/icons/flame-lime.svg" /><text class="n-ring-pct num">{{nutritionTotal.percent}}%</text></view>
        </view>
      </view>
      <view class="n-macros">
        <view class="n-macro"><image class="icon" src="/images/icons/leaf-lime.svg" /><view><text class="label-dark">蛋白质</text><view class="n-macro-value num">{{nutritionTotal.protein}}<text class="n-macro-g"> g</text></view></view></view>
        <view class="n-macro"><image class="icon" src="/images/icons/drop-lime.svg" /><view><text class="label-dark">碳水化合物</text><view class="n-macro-value num">{{nutritionTotal.carbs}}<text class="n-macro-g"> g</text></view></view></view>
        <view class="n-macro"><image class="icon" src="/images/icons/drop-lime.svg" /><view><text class="label-dark">脂肪</text><view class="n-macro-value num">{{nutritionTotal.fat}}<text class="n-macro-g"> g</text></view></view></view>
      </view>
    </view>

    <view class="n-meal" wx:for="{{mealGroups}}" wx:key="key">
      <view class="n-meal-head">
        <text class="n-meal-time num">{{item.time}}</text>
        <text class="n-meal-name">{{item.label}}</text>
        <text class="n-meal-kcal num">{{item.calories}} <text class="n-meal-unit">kcal</text></text>
      </view>
      <view class="n-meal-body">
        <image class="n-meal-image" src="{{item.image}}" mode="aspectFill" />
        <view class="n-meal-items">
          <view class="n-meal-item" wx:for="{{item.items}}" wx:for-item="food" wx:key="index">
            <text class="n-food-name">{{food.name}}</text>
            <text class="n-food-weight num">{{food.weight}}</text>
            <text class="n-food-kcal num">{{food.calories}} kcal</text>
          </view>
        </view>
      </view>
    </view>
    <view class="empty" wx:if="{{mealGroups.length === 0}}">
      <view class="empty-figure"><image class="icon-lg" src="/images/icons/fork-ink.svg" /></view>
      <view class="empty-title">这天没有饮食记录</view>
      <view class="empty-text">换一天看看，或回到“饮食”记录一餐。</view>
    </view>

    <picker mode="date" value="{{nutritionDate}}" end="{{today}}" bindchange="onNutritionDateChange">
      <view class="earlier"><image class="icon" src="/images/icons/clock-ink.svg" /><text class="earlier-text">查看更早记录</text><image class="icon" src="/images/icons/chevron-right-ink.svg" /></view>
    </picker>
  </block>
</view>
