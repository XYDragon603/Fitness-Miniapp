.history-hero { padding-bottom: 20rpx; }

/* 日历 */
.cal-head { display: flex; align-items: center; justify-content: space-between; margin: 36rpx 0 20rpx; }
.cal-arrow { width: 48rpx; height: 48rpx; padding: 6rpx; }
.cal-title { font-size: 38rpx; font-weight: 800; }
.cal-week { display: flex; padding: 0 0 12rpx; }
.cal-week text { flex: 1; text-align: center; font-size: 25rpx; color: var(--text-2); }
.cal-row { display: flex; }
.cal-cell { flex: 1; height: 112rpx; margin: 4rpx; border-radius: 18rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; }
.cal-cell:active { background: var(--surface-2); }
.cal-cell.out .cal-day { color: #BDBCB6; }
.cal-cell.today { background: var(--ink); }
.cal-cell.today .cal-day { color: #FFFFFF; }
.cal-day { font-size: 32rpx; font-weight: 700; }
.cal-dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: #8CCB2E; }
.cal-cell.today .cal-dot { background: var(--lime); }
.cal-moon { width: 28rpx; height: 28rpx; }
.cal-none { height: 14rpx; }
.cal-legend { display: flex; align-items: center; justify-content: center; gap: 28rpx; margin: 24rpx 0 8rpx; padding-bottom: 28rpx; border-bottom: 2rpx solid var(--line); font-size: 25rpx; color: var(--text-2); }
.cal-legend-item { display: flex; align-items: center; gap: 10rpx; }
.cal-legend-sep { width: 2rpx; height: 28rpx; background: var(--line); }

.recent { display: flex; align-items: center; gap: 24rpx; padding: 26rpx 24rpx; margin-bottom: 14rpx; background: var(--surface); border-radius: 22rpx; }
.recent:active { background: #FAF9F6; }
.recent-date { width: 150rpx; display: flex; flex-direction: column; gap: 4rpx; }
.recent-day { font-size: 32rpx; font-weight: 800; }
.recent-week { font-size: 24rpx; color: var(--text-2); }
.recent-sep { width: 2rpx; height: 64rpx; background: var(--line); }
.recent-icon { width: 56rpx; height: 56rpx; }
.recent-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.recent-name { font-size: 32rpx; font-weight: 800; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.recent-status { font-size: 24rpx; color: var(--text-2); }

/* 饮食 */
.date-pick { display: flex; align-items: center; gap: 18rpx; height: 96rpx; padding: 0 26rpx; margin: 28rpx 0 20rpx; border-radius: 20rpx; background: var(--surface-2); }
.date-pick-text { flex: 1; font-size: 31rpx; font-weight: 700; }

.n-total { padding: 30rpx 30rpx 26rpx; }
.n-total-top { position: relative; display: flex; align-items: center; justify-content: space-between; padding-bottom: 24rpx; border-bottom: 2rpx solid var(--dark-line); }
.n-total-label { font-size: 28rpx; }
.n-total-value { font-size: 96rpx; line-height: 1.1; font-weight: 800; letter-spacing: -2rpx; }
.n-total-unit { font-size: 44rpx; letter-spacing: 0; }
.n-ring { position: relative; width: 170rpx; height: 170rpx; }
.n-ring-img { width: 170rpx; height: 170rpx; }
.n-ring-center { position: absolute; top: 0; left: 0; right: 0; bottom: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2rpx; }
.n-ring-pct { font-size: 28rpx; font-weight: 800; }
.n-macros { display: flex; padding-top: 22rpx; }
.n-macro { flex: 1; display: flex; align-items: center; gap: 12rpx; }
.n-macro + .n-macro { padding-left: 16rpx; border-left: 2rpx solid var(--dark-line); }
.n-macro-value { font-size: 38rpx; font-weight: 800; }
.n-macro-g { font-size: 24rpx; }

.n-meal { margin-top: 30rpx; }
.n-meal-head { display: flex; align-items: baseline; gap: 18rpx; margin-bottom: 14rpx; }
.n-meal-time { font-size: 26rpx; color: var(--text-2); }
.n-meal-name { flex: 1; font-size: 36rpx; font-weight: 800; }
.n-meal-kcal { font-size: 38rpx; font-weight: 800; }
.n-meal-unit { font-size: 24rpx; font-weight: 600; }
.n-meal-body { display: flex; gap: 22rpx; padding: 16rpx; background: var(--surface); border-radius: 22rpx; }
.n-meal-image { width: 200rpx; height: 150rpx; border-radius: 16rpx; flex-shrink: 0; }
.n-meal-items { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: center; }
.n-meal-item { display: flex; align-items: center; gap: 12rpx; padding: 14rpx 0; }
.n-meal-item + .n-meal-item { border-top: 2rpx solid var(--line); }
.n-food-name { flex: 1; min-width: 0; font-size: 27rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.n-food-weight { font-size: 24rpx; color: var(--text-2); }
.n-food-kcal { width: 140rpx; text-align: right; font-size: 25rpx; color: var(--text-2); }

.earlier { display: flex; align-items: center; gap: 18rpx; height: 100rpx; padding: 0 26rpx; margin-top: 30rpx; border-radius: 20rpx; background: var(--surface); }
.earlier-text { flex: 1; font-size: 30rpx; font-weight: 700; }
