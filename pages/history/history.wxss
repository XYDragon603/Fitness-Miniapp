.history-page {
  padding-bottom: calc(env(safe-area-inset-bottom) + 132rpx);
}

.history-header {
  padding-bottom: 24rpx;
}

.history-tab-bar {
  margin-bottom: 24rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(217, 232, 228, 0.92);
  box-shadow: 0 10rpx 24rpx rgba(52, 92, 89, 0.06);
}

.history-tab-item {
  color: var(--text-secondary);
}

.calendar-card {
  padding: 24rpx 24rpx 28rpx;
  background:
    radial-gradient(circle at top right, rgba(124, 184, 214, 0.16), transparent 32%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(249, 252, 251, 0.96));
}

.calendar-shell {
  display: flex;
  flex-direction: column;
}

.calendar-intro {
  margin-bottom: 22rpx;
}

.calendar-kicker {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: var(--text-hint);
}

.calendar-heading {
  margin-top: 12rpx;
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.35;
}

.calendar-note {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: var(--text-secondary);
  line-height: 1.8;
}

.calendar-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid rgba(217, 232, 228, 0.72);
  border-bottom: 1rpx solid rgba(217, 232, 228, 0.72);
}

.calendar-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.calendar-switch {
  min-width: 100rpx;
  padding: 12rpx 16rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--primary-color-strong);
  background: rgba(208, 103, 103, 0.14);
  border: 1rpx solid rgba(185, 82, 82, 0.18);
  font-weight: 700;
  box-shadow: 0 8rpx 18rpx rgba(185, 82, 82, 0.08);
}

.calendar-weekdays,
.calendar-row {
  display: flex;
}

.calendar-weekdays {
  margin-bottom: 12rpx;
}

.calendar-weekday,
.calendar-day {
  width: calc(100% / 7);
  text-align: center;
}

.calendar-weekday {
  font-size: 21rpx;
  color: var(--text-hint);
  padding: 8rpx 0;
}

.calendar-day {
  height: 82rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  background: rgba(255, 255, 255, 0.82);
  border: 1rpx solid rgba(217, 232, 228, 0.92);
  color: var(--text-secondary);
  box-sizing: border-box;
}

.calendar-day.empty {
  background: transparent;
  border-color: transparent;
}

.calendar-day.has-record {
  box-shadow: 0 8rpx 18rpx rgba(52, 92, 89, 0.06);
  border-width: 2rpx;
}

.calendar-day-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.calendar-day-number {
  font-size: 24rpx;
  font-weight: 700;
}

.calendar-record-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 999rpx;
  box-shadow: 0 0 0 6rpx rgba(255, 255, 255, 0.68);
}

.calendar-day.day1 {
  background: rgba(208, 103, 103, 0.16);
  color: var(--primary-color-strong);
  border-color: rgba(185, 82, 82, 0.22);
}

.calendar-day.day2 {
  background: rgba(79, 156, 196, 0.18);
  color: #215E7E;
  border-color: rgba(79, 156, 196, 0.26);
}

.calendar-day.day3 {
  background: rgba(78, 174, 125, 0.18);
  color: #317556;
  border-color: rgba(78, 174, 125, 0.26);
}

.calendar-day.rest {
  background: rgba(95, 154, 136, 0.18);
  color: #426F62;
  border-color: rgba(95, 154, 136, 0.28);
}

.calendar-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 12rpx;
  padding-top: 14rpx;
}

.legend-item {
  display: flex;
}

.legend-chip {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  min-height: 46rpx;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(217, 232, 228, 0.92);
  background: rgba(255, 255, 255, 0.82);
}

.legend-accent {
  width: 12rpx;
  height: 28rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.legend-text {
  font-size: 22rpx;
  color: var(--text-secondary);
  font-weight: 700;
  line-height: 1.4;
}

.history-section-label {
  margin: 8rpx 4rpx 16rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 600;
}

.history-card {
  padding: 28rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(249, 252, 251, 0.96));
}

.training-history-card,
.nutrition-history-card {
  overflow: hidden;
}

.rest-history-card {
  background: linear-gradient(180deg, #FCFEFD 0%, #F4FBF8 100%);
}

.history-entry-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.history-date-section {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.history-date {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.history-week,
.history-count {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-hint);
}

.history-badge {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.history-badge.rest {
  border: 1rpx solid rgba(95, 154, 136, 0.24);
}

.history-entry-copy {
  margin-top: 18rpx;
}

.history-entry-title {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-secondary);
}

.history-entry-note {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.75;
  color: var(--text-secondary);
}

.history-stats {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
}

.stat-item {
  flex: 1;
  min-width: 0;
  padding: 18rpx 14rpx;
  border-radius: 22rpx;
  background: rgba(244, 248, 247, 0.86);
  border: 1rpx solid rgba(217, 232, 228, 0.92);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.stat-label {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--text-hint);
}

.entry-progress-track {
  margin-top: 18rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: rgba(217, 232, 228, 0.82);
  overflow: hidden;
}

.entry-progress-fill {
  height: 100%;
  border-radius: inherit;
}

.rest-stat-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.rest-stat-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(143, 184, 170, 0.18);
  color: #5D7F74;
  font-size: 22rpx;
  font-weight: 600;
}

.rest-stat-pill.muted {
  background: rgba(25, 53, 59, 0.06);
  color: var(--text-secondary);
}

.nutrition-summary {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
}

.nutrition-item {
  flex: 1;
  min-width: 0;
  padding: 20rpx 10rpx 18rpx;
  border-radius: 22rpx;
  background: rgba(244, 248, 247, 0.82);
  border: 1rpx solid rgba(217, 232, 228, 0.92);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.nutrition-value {
  font-size: 30rpx;
  font-weight: 800;
}

.nutrition-unit {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--text-hint);
}

.nutrition-label {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--text-hint);
}

.cal-value {
  color: var(--primary-color-strong);
}

.protein-value {
  color: #4B8F72;
}

.fat-value {
  color: #B17D4C;
}

.carb-value {
  color: #2F6C8C;
}

.food-detail-list {
  margin-top: 10rpx;
}

.food-detail-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(217, 232, 228, 0.72);
}

.food-detail-item:last-child {
  border-bottom: none;
}

.food-thumb,
.food-thumb-placeholder {
  width: 82rpx;
  height: 82rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
}

.food-thumb {
  display: block;
}

.food-thumb-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, rgba(238, 246, 244, 0.88), rgba(244, 248, 247, 0.92));
  color: var(--text-secondary);
  font-size: 22rpx;
  font-weight: 600;
}

.food-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.food-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.5;
}

.food-cal {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-hint);
}

.detail-toggle {
  margin-top: 18rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(79, 156, 196, 0.16);
  color: #215E7E;
  font-size: 22rpx;
  font-weight: 700;
  border: 1rpx solid rgba(79, 156, 196, 0.2);
}

.history-empty {
  margin-top: 8rpx;
  text-align: center;
  padding: 54rpx 32rpx;
}

.empty-hint {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: var(--text-secondary);
  line-height: 1.7;
}

.detail-modal {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1000;
  background: rgba(17, 20, 35, 0.48);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 24rpx;
  box-sizing: border-box;
}

.detail-content {
  width: 100%;
  max-height: 86vh;
  padding: 32rpx 28rpx 36rpx;
  box-sizing: border-box;
  border-radius: 32rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, #F9FCFB 100%);
  box-shadow: 0 18rpx 60rpx rgba(0, 0, 0, 0.18);
}

.detail-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 10rpx;
}

.detail-title-wrap {
  flex: 1;
  min-width: 0;
}

.detail-caption {
  font-size: 21rpx;
  color: var(--text-hint);
  letter-spacing: 2rpx;
}

.detail-title {
  margin-top: 10rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.detail-close {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(244, 248, 247, 0.94);
  color: var(--text-secondary);
  font-size: 22rpx;
  font-weight: 600;
}

.detail-meta {
  margin-bottom: 22rpx;
  font-size: 23rpx;
  color: var(--text-secondary);
  line-height: 1.7;
}

.detail-scroll {
  max-height: 56vh;
}

.detail-exercise {
  margin-bottom: 18rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: rgba(244, 248, 247, 0.78);
  border: 1rpx solid rgba(217, 232, 228, 0.92);
}

.detail-ex-header {
  margin-bottom: 14rpx;
}

.detail-ex-name {
  font-size: 27rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.5;
}

.completed-text {
  color: #4B8F72;
}

.detail-sets {
  border-radius: 20rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(217, 232, 228, 0.92);
  overflow: hidden;
}

.detail-set-header,
.detail-set-row {
  display: flex;
  align-items: center;
}

.detail-set-header {
  padding: 14rpx 10rpx;
  background: rgba(244, 248, 247, 0.86);
  border-bottom: 1rpx solid rgba(217, 232, 228, 0.92);
}

.detail-set-row {
  padding: 16rpx 10rpx;
  border-bottom: 1rpx solid rgba(217, 232, 228, 0.62);
}

.detail-set-row:last-child {
  border-bottom: none;
}

.detail-set-col {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-hint);
}

.detail-set-row .detail-set-col {
  font-size: 23rpx;
  color: var(--text-primary);
}

.done-text {
  color: #4B8F72 !important;
  font-weight: 700;
}

.undone-text {
  color: var(--text-hint) !important;
}

.detail-actions {
  margin-top: 24rpx;
  padding-bottom: env(safe-area-inset-bottom);
}

.rest-detail-card {
  padding: 22rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #FCFEFD 0%, #F4FBF8 100%);
  border: 1rpx solid rgba(143, 184, 170, 0.24);
}

.rest-detail-row + .rest-detail-row {
  margin-top: 16rpx;
}

.rest-detail-label {
  display: block;
  font-size: 22rpx;
  color: var(--text-hint);
}

.rest-detail-value {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-primary);
  line-height: 1.7;
}

.detail-delete-btn {
  color: var(--danger-color) !important;
  border-color: rgba(217, 120, 120, 0.3) !important;
  background: rgba(217, 120, 120, 0.08) !important;
}
