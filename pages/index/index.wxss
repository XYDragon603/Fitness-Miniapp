/* ========== 计划总览 ========== */
.plan.has-start { padding-bottom: calc(env(safe-area-inset-bottom) + var(--tabbar-height) + 180rpx); }

.plan-current { display: flex; align-items: center; gap: 20rpx; padding: 30rpx 32rpx; }
.plan-current:active { opacity: 0.94; }
.plan-current-copy { position: relative; flex: 1; min-width: 0; }
.plan-current-title { margin-top: 10rpx; font-size: 40rpx; font-weight: 800; color: #FFFFFF; }
.plan-current-meta { margin-top: 8rpx; font-size: 28rpx; color: var(--dark-text-2); }

.day-tiles { white-space: nowrap; margin: 24rpx calc(-1 * var(--gutter)) 0; padding: 0 var(--gutter); width: auto; }
.day-tile { display: inline-flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; width: 184rpx; height: 132rpx; margin-right: 14rpx; border-radius: 20rpx; background: var(--surface-2); vertical-align: top; }
.day-tile.active { background: var(--lime); }
.day-tile-no { font-size: 24rpx; color: var(--text-2); }
.day-tile-name { max-width: 164rpx; overflow: hidden; text-overflow: ellipsis; font-size: 30rpx; font-weight: 800; color: var(--text); }
.day-tile.active .day-tile-no { color: var(--ink); }

.plan-day-head { margin-top: 36rpx; }
.plan-day-title { font-size: 46rpx; font-weight: 800; }

.plan-ex { display: flex; align-items: center; gap: 22rpx; padding: 18rpx 24rpx 18rpx 20rpx; margin-bottom: 14rpx; background: var(--surface); border-radius: 22rpx; }
.plan-ex:active { background: #FAF9F6; }
.plan-ex-no { width: 40rpx; font-size: 25rpx; color: var(--text-2); }
.plan-ex-image { width: 140rpx; height: 100rpx; flex-shrink: 0; }
.plan-ex-image.media { width: 104rpx; height: 104rpx; margin: 0 18rpx; border: 2rpx solid var(--line); }
.plan-ex-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4rpx; }
.plan-ex-name { font-size: 32rpx; font-weight: 800; }
.plan-ex-meta { font-size: 26rpx; color: var(--text-2); }

.rest-box { display: flex; align-items: center; gap: 28rpx; padding: 28rpx; background: var(--surface); border-radius: 22rpx; }
.rest-box-icon { width: 120rpx; height: 120rpx; border-radius: 18rpx; background: var(--surface-2); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.rest-box-copy { display: flex; flex-direction: column; gap: 6rpx; }
.rest-box-title { font-size: 32rpx; font-weight: 800; }
.rest-box-text { font-size: 26rpx; color: var(--text-2); }

.plan-start { position: fixed; left: var(--gutter); right: var(--gutter); bottom: calc(env(safe-area-inset-bottom) + var(--tabbar-height) + 16rpx); z-index: 40; }
.plan-start .lime-btn { height: 104rpx; }

/* ========== 动作教学弹层 ========== */
.guide-block { margin-bottom: 32rpx; }
.guide-title { font-size: 30rpx; font-weight: 800; margin-bottom: 12rpx; }
.guide-text { font-size: 28rpx; color: var(--text-2); line-height: 1.7; }
.guide-chips { display: flex; flex-wrap: wrap; gap: 12rpx; }
.guide-copy { margin-top: 16rpx; height: 88rpx; }

/* ========== 子页 ========== */
.subpage-scroll { height: 100vh; background: var(--bg); }

.manager-hero { padding: 32rpx 32rpx 28rpx; min-height: 400rpx; }
.manager-badge { position: relative; height: 48rpx; padding: 0 18rpx; font-size: 24rpx; font-weight: 800; border-radius: 10rpx; }
.manager-title { position: relative; margin-top: 18rpx; padding-right: 260rpx; font-size: 52rpx; line-height: 1.25; font-weight: 800; }
.manager-meta { position: relative; margin-top: 8rpx; font-size: 30rpx; color: #D6DBDD; }
.manager-image { position: absolute; right: 10rpx; top: 56rpx; width: 270rpx; height: 200rpx; }
.manager-pills { position: relative; display: flex; align-items: center; gap: 14rpx; margin-top: 44rpx; }
.manager-pill { width: 104rpx; height: 104rpx; border-radius: 16rpx; background: var(--dark-2); border: 2rpx solid var(--dark-line); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2rpx; }
.manager-pill.first { border-color: var(--lime); background: #1A2419; }
.manager-pill-day { font-size: 20rpx; color: var(--dark-text-2); }
.manager-pill-focus { font-size: 30rpx; font-weight: 800; color: #FFFFFF; max-width: 96rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.manager-pill.first .manager-pill-day, .manager-pill.first .manager-pill-focus { color: var(--lime); }
.manager-pill-arrow { margin-left: auto; }

.plan-card { display: flex; align-items: center; gap: 20rpx; padding: 26rpx 24rpx; margin-bottom: 18rpx; background: var(--surface); border-radius: var(--radius-lg); }
.plan-card-image { width: 170rpx; height: 150rpx; flex-shrink: 0; }
.plan-card-body { flex: 1; min-width: 0; }
.plan-card-title { font-size: 34rpx; font-weight: 800; }
.plan-card-meta { margin-top: 6rpx; font-size: 26rpx; color: var(--text-2); }
.plan-card-desc { margin-top: 10rpx; font-size: 23rpx; color: var(--text-2); line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.plan-card-side { display: flex; flex-direction: column; align-items: flex-end; gap: 30rpx; flex-shrink: 0; }
.plan-card-use { height: 68rpx; padding: 0 30rpx; font-size: 28rpx; border-radius: 14rpx; }
.plan-card-edit { display: flex; align-items: center; gap: 6rpx; font-size: 24rpx; color: var(--text); }

/* 编辑器 */
.editor-days { white-space: nowrap; margin: 0 calc(-1 * var(--gutter)); padding: 0 var(--gutter); width: auto; }
.editor-day { display: inline-flex; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx; min-width: 232rpx; height: 116rpx; margin-right: 14rpx; padding: 0 20rpx; border-radius: 20rpx; background: var(--surface-2); vertical-align: top; }
.editor-day.active { background: var(--lime); }
.editor-day-no { font-size: 32rpx; font-weight: 800; }
.editor-day-name { font-size: 24rpx; color: var(--text-2); max-width: 200rpx; overflow: hidden; text-overflow: ellipsis; }
.editor-day.active .editor-day-name { color: var(--ink); }
.editor-day.add { flex-direction: row; gap: 10rpx; font-size: 28rpx; font-weight: 700; }
.editor-day-head { margin-top: 36rpx; }

.draft-ex { display: flex; align-items: center; gap: 18rpx; padding: 22rpx 20rpx 22rpx 12rpx; margin-bottom: 14rpx; background: var(--surface); border-radius: 22rpx; }
.draft-ex { transition: transform 0.15s ease; }
.draft-grip-area { width: 56rpx; height: 96rpx; margin: -20rpx -10rpx -20rpx -12rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.draft-grip { width: 36rpx; height: 36rpx; flex-shrink: 0; }
.draft-image { width: 150rpx; height: 104rpx; flex-shrink: 0; }
.draft-image.media { width: 104rpx; height: 104rpx; margin: 0 23rpx; border: 2rpx solid var(--line); }
.draft-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.draft-name { font-size: 32rpx; font-weight: 800; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.draft-meta { font-size: 28rpx; color: var(--text-2); }
.draft-action { width: 44rpx; height: 44rpx; padding: 6rpx; flex-shrink: 0; }

.outline-btn { display: flex; align-items: center; gap: 16rpx; height: 108rpx; padding: 0 32rpx; margin-top: 20rpx; border: 2rpx solid #8E8E89; border-radius: 22rpx; background: var(--surface); }
.outline-btn:active { background: #FAF9F6; }
.outline-btn-text { flex: 1; font-size: 32rpx; font-weight: 700; }
.outline-btn-text.center { flex: none; margin: 0 auto 0 0; }
.text-link { text-align: center; margin-top: 22rpx; font-size: 26rpx; color: var(--text-2); text-decoration: underline; }
.editor-divider { height: 2rpx; background: var(--line); margin: 36rpx 0 16rpx; }

/* 弹层表单 */
.sheet-grid { display: flex; gap: 20rpx; }
.sheet-col { flex: 1; min-width: 0; }
.sheet-stepper { justify-content: space-between; }
.sheet-stepper-value { font-size: 40rpx; font-weight: 800; }
.sheet-textarea { min-height: 160rpx; }
.sheet-save { margin-top: 40rpx; }
.sheet-actions { display: flex; gap: 20rpx; margin-top: 40rpx; }
.sheet-delete { flex: 1; color: var(--danger); }
.sheet-confirm { flex: 1; height: 104rpx; }
