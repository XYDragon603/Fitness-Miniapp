/* ========== 深色顶部 ========== */
.diet-top { background: var(--dark); color: #FFFFFF; border-radius: 0 0 40rpx 40rpx; padding-bottom: 32rpx; }
.diet-top-inner { padding: 0 var(--gutter); }
.diet-top .hero-title { color: #FFFFFF; }
.diet-top .hero-date, .diet-top .hero-sub { color: #D6DBDD; }

.intake { padding: 30rpx 28rpx 28rpx; border-radius: 30rpx; }
.intake-top { display: flex; align-items: flex-start; justify-content: space-between; }
.intake-label { font-size: 28rpx; font-weight: 700; color: #FFFFFF; }
.intake-value { margin-top: 2rpx; font-size: 104rpx; line-height: 1.1; font-weight: 800; letter-spacing: -2rpx; }
.intake-unit { font-size: 40rpx; font-weight: 600; letter-spacing: 0; }
.intake-goal { display: flex; flex-direction: column; align-items: flex-end; gap: 4rpx; padding-top: 50rpx; }
.intake-goal-label { font-size: 24rpx; color: #D6DBDD; }
.intake-goal-value { font-size: 28rpx; color: #FFFFFF; }
.intake-goal-link { font-size: 26rpx; color: var(--lime); font-weight: 700; }
.intake-bar-row { display: flex; align-items: center; gap: 24rpx; margin-top: 20rpx; }
.intake-bar { flex: 1; height: 22rpx; border-radius: 12rpx; }
.intake-percent { font-size: 26rpx; color: #D6DBDD; }

.macros { display: flex; margin-top: 30rpx; padding-top: 28rpx; border-top: 2rpx solid var(--dark-line); }
.macro { flex: 1; min-width: 0; padding: 0 20rpx; display: flex; flex-direction: column; gap: 4rpx; }
.macro:first-child { padding-left: 0; }
.macro + .macro { border-left: 2rpx solid var(--dark-line); }
.macro-label { font-size: 26rpx; color: #FFFFFF; }
.macro-value { font-size: 46rpx; font-weight: 800; }
.macro-unit { font-size: 26rpx; font-weight: 600; }
.macro-target { font-size: 24rpx; color: #D6DBDD; }
.macro-bar { margin-top: 12rpx; }
.intake-btn { margin-top: 32rpx; }

/* ========== 饮食记录 ========== */
.diet-body { padding-top: 4rpx; }
.meal { display: flex; align-items: center; gap: 24rpx; padding: 16rpx 22rpx 16rpx 16rpx; margin-bottom: 16rpx; background: var(--surface); border-radius: 24rpx; }
.meal:active { background: #FAF9F6; }
.meal-image { width: 180rpx; height: 156rpx; border-radius: 18rpx; flex-shrink: 0; background: var(--surface-2); }
.meal-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.meal-title-row { display: flex; align-items: baseline; gap: 16rpx; }
.meal-title { font-size: 36rpx; font-weight: 800; }
.meal-time { font-size: 24rpx; color: var(--text-3); }
.meal-kcal { font-size: 30rpx; font-weight: 700; }
.meal-names { font-size: 24rpx; color: var(--text-2); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.meal-delete { font-size: 26rpx; color: var(--danger); padding: 12rpx 0 12rpx 20rpx; }

/* ========== 添加方式 ========== */
.entry-sheet { padding-top: 24rpx; }
.scan-modes { display: flex; gap: 16rpx; }
.scan-mode { flex: 1; height: 100rpx; border-radius: 20rpx; border: 2rpx solid var(--dark-line); display: flex; align-items: center; justify-content: center; gap: 14rpx; font-size: 30rpx; font-weight: 700; color: #FFFFFF; }
.scan-mode.active { background: var(--lime); border-color: var(--lime); color: var(--ink); }
.scan-mode-ring { width: 36rpx; height: 36rpx; border-radius: 50%; border: 3rpx solid #D6DBDD; }
.scan-mode-desc { margin: 18rpx 0 26rpx; font-size: 25rpx; color: var(--dark-text-2); }
.entry { display: flex; align-items: center; gap: 26rpx; padding: 30rpx 30rpx; margin-bottom: 16rpx; border-radius: 22rpx; background: var(--dark-2); }
.entry.lime { background: var(--lime); }
.entry:active { opacity: 0.9; }
.entry-icon { width: 60rpx; height: 60rpx; flex-shrink: 0; }
.entry-copy { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.entry-title { font-size: 34rpx; font-weight: 800; color: #FFFFFF; }
.entry-desc { font-size: 24rpx; color: var(--dark-text-2); }
.entry.lime .entry-title { color: var(--ink); }
.entry.lime .entry-desc { color: #2F3A1A; }

/* ========== 子页 ========== */
.subpage-scroll { height: 100vh; background: var(--bg); }

/* 手动填写 */
.manual-top { background: var(--dark); padding-bottom: 40rpx; }
.manual-top-inner { padding: 0 var(--gutter); }
.manual-title { color: #FFFFFF; }
.manual-sub { color: #D6DBDD; }
.manual-body { margin-top: -28rpx; padding-top: 4rpx; background: var(--bg); border-radius: 36rpx 36rpx 0 0; }
.field-input.big { font-size: 44rpx; }
.field-sep { width: 2rpx; height: 56rpx; background: var(--line); }
.unit-g { min-width: 60rpx; text-align: center; font-size: 34rpx; color: var(--text); }
.nutri-grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.nutri-cell { width: 48.5%; margin-bottom: 16rpx; padding: 22rpx 26rpx; background: var(--surface); border-radius: 22rpx; }
.nutri-label { font-size: 26rpx; color: var(--text-2); }
.nutri-input-row { display: flex; align-items: center; gap: 12rpx; margin-top: 8rpx; }
.nutri-input { flex: 1; min-width: 0; height: 72rpx; font-size: 46rpx; font-weight: 800; color: var(--text); }
.manual-actions { display: flex; flex-direction: column; gap: 18rpx; margin-top: 56rpx; }

/* 营养参考目标 */
.goal-rows { margin-top: 4rpx; }
.goal-row { padding: 26rpx 24rpx; }
.goal-row-label { flex: 1; font-size: 31rpx; font-weight: 700; }
.goal-row-input { width: 180rpx; text-align: right; font-size: 40rpx; font-weight: 800; color: var(--text); }
.goal-row-unit { width: 44rpx; font-size: 25rpx; color: var(--text-2); }
.goal-group-label { margin: 30rpx 0 14rpx; font-size: 28rpx; font-weight: 800; }
.pill-row { display: flex; gap: 14rpx; }
.pill { flex: 1; height: 84rpx; border-radius: 18rpx; background: var(--surface-2); display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: 600; }
.pill.active { background: var(--lime); font-weight: 800; }
.goal-custom { margin-top: 16rpx; }
.goal-preview { margin-top: 32rpx; padding: 30rpx 30rpx 26rpx; }
.goal-preview-value { position: relative; margin-top: 4rpx; font-size: 90rpx; font-weight: 800; }
.goal-preview-unit { font-size: 34rpx; font-weight: 600; }
.goal-preview-macros { position: relative; display: flex; margin-top: 18rpx; }
.goal-preview-macro { flex: 1; padding: 0 18rpx; display: flex; flex-direction: column; gap: 6rpx; }
.goal-preview-macro:first-child { padding-left: 0; }
.goal-preview-macro + .goal-preview-macro { border-left: 2rpx solid var(--dark-line); }
.goal-preview-num { font-size: 44rpx; font-weight: 800; }
.goal-preview-g { font-size: 24rpx; }
.goal-preview-pct { font-size: 24rpx; color: #D6DBDD; }
.goal-preview-note { display: flex; align-items: center; gap: 8rpx; margin-top: 22rpx; font-size: 22rpx; color: var(--dark-text-2); }

/* 识别结果 */
.scan-photo { width: 100%; height: 400rpx; border-radius: 26rpx; background: var(--surface-2); }
.scan-note { margin-top: 18rpx; padding: 18rpx 22rpx; border-radius: 16rpx; background: var(--surface-2); font-size: 24rpx; color: var(--text-2); }
.scan-note.warn { background: #F5E8CF; color: #8A5A12; }
.scan-food { display: flex; gap: 22rpx; padding: 18rpx; margin-top: 16rpx; background: var(--surface); border-radius: 22rpx; }
.scan-food-image { width: 168rpx; height: 168rpx; border-radius: 16rpx; flex-shrink: 0; }
.scan-food-body { flex: 1; min-width: 0; }
.scan-food-top { display: flex; justify-content: space-between; align-items: flex-start; }
.scan-food-name { font-size: 32rpx; font-weight: 800; }
.scan-food-weight { margin-top: 4rpx; font-size: 25rpx; color: var(--text-2); }
.scan-food-edit { display: flex; align-items: center; gap: 4rpx; font-size: 24rpx; color: var(--text-2); }
.portion-row { display: flex; gap: 10rpx; margin-top: 18rpx; }
.portion { flex: 1; height: 64rpx; border-radius: 14rpx; background: var(--surface-2); display: flex; align-items: center; justify-content: center; font-size: 25rpx; color: var(--text-2); }
.portion.active { background: var(--lime); color: var(--ink); font-weight: 800; }
.portion-custom { margin-top: 12rpx; min-height: 80rpx; }
.portion-custom .field-input { height: 80rpx; font-size: 30rpx; }
.scan-total { display: flex; align-items: flex-end; margin-top: 22rpx; padding: 26rpx 26rpx; border-radius: 24rpx; background: var(--dark); color: #FFFFFF; }
.scan-total-main { flex: 1.6; display: flex; flex-direction: column; gap: 4rpx; padding-right: 16rpx; border-right: 2rpx solid var(--dark-line); }
.scan-total-kcal { font-size: 30rpx; font-weight: 700; }
.scan-total-num { font-size: 60rpx; font-weight: 800; }
.scan-total-macro { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8rpx; font-size: 30rpx; font-weight: 700; }
.scan-disclaimer { display: flex; align-items: flex-start; gap: 8rpx; margin-top: 16rpx; font-size: 22rpx; color: var(--text-2); line-height: 1.5; }
.rescan { display: flex; align-items: center; gap: 16rpx; margin-top: 20rpx; padding: 22rpx 24rpx; border-radius: 20rpx; background: var(--surface); }
.rescan-copy { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.rescan-title { font-size: 28rpx; font-weight: 800; }
.rescan-text { font-size: 23rpx; color: var(--text-2); }
.rescan-action { font-size: 26rpx; font-weight: 800; }
.scan-fix { flex: 1; }
.scan-confirm { flex: 1.6; height: 104rpx; }

/* 食物候选 / 常吃的 */
.suggest-list { margin-top: 12rpx; background: var(--surface); border-radius: 20rpx; overflow: hidden; }
.suggest-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 24rpx 26rpx; }
.suggest-row + .suggest-row { border-top: 2rpx solid var(--line); }
.suggest-row:active { background: #FAF9F6; }
.suggest-name { font-size: 30rpx; font-weight: 700; }
.suggest-hint { font-size: 23rpx; color: var(--text-2); }
.suggest-hint.is-frequent { color: #5E8B14; font-weight: 700; }
.frequent-title { margin: 6rpx 0 14rpx; font-size: 25rpx; color: var(--dark-text-2); }
.frequent-row { white-space: nowrap; margin: 0 calc(-1 * var(--gutter)) 26rpx; padding: 0 var(--gutter); width: auto; }
.frequent-chip { display: inline-flex; flex-direction: column; gap: 4rpx; margin-right: 14rpx; padding: 16rpx 22rpx; border-radius: 18rpx; background: var(--dark-2); border: 2rpx solid var(--dark-line); vertical-align: top; }
.frequent-chip:active { background: var(--dark-3); }
.frequent-name { font-size: 28rpx; font-weight: 700; color: #FFFFFF; }
.frequent-kcal { font-size: 22rpx; color: var(--dark-text-2); }
