.nutrition-page {
  padding-bottom: calc(env(safe-area-inset-bottom) + 132rpx);
}

.nutrition-header {
  padding-bottom: 24rpx;
}

.intake-overview {
  padding: 30rpx;
  background:
    radial-gradient(circle at top right, rgba(124, 184, 214, 0.18), transparent 32%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(249, 252, 251, 0.96));
}

.intake-overview-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.overview-copy {
  flex: 1;
  min-width: 0;
}

.overview-kicker {
  display: block;
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: var(--text-hint);
}

.overview-heading {
  display: block;
  margin-top: 14rpx;
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.35;
}

.overview-note {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.8;
}

.overview-energy {
  min-width: 154rpx;
  padding: 18rpx 18rpx 16rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid rgba(217, 232, 228, 0.92);
  box-shadow: 0 10rpx 28rpx rgba(52, 92, 89, 0.08);
  text-align: center;
}

.overview-energy-value {
  display: block;
  font-size: 42rpx;
  line-height: 1.1;
  font-weight: 700;
  color: var(--primary-color-strong);
}

.overview-energy-unit {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-hint);
}

.overview-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}

.overview-pill {
  min-width: 178rpx;
  padding: 16rpx 18rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.82);
  border: 1rpx solid rgba(217, 232, 228, 0.9);
}

.overview-pill-label {
  display: block;
  font-size: 20rpx;
  color: var(--text-hint);
}

.overview-pill-value {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.macro-overview-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 22rpx;
}

.macro-overview-card {
  width: calc(50% - 7rpx);
  padding: 24rpx 22rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  border: 1rpx solid rgba(217, 232, 228, 0.92);
  background: rgba(255, 255, 255, 0.86);
}

.macro-overview-label {
  display: block;
  font-size: 22rpx;
  color: var(--text-hint);
}

.macro-overview-value {
  display: block;
  margin-top: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.45;
}

.macro-overview-unit {
  display: block;
  margin-top: 8rpx;
  font-size: 21rpx;
  color: var(--text-secondary);
}

.calories-card {
  background: linear-gradient(180deg, rgba(247, 230, 230, 0.9), rgba(255, 255, 255, 0.94));
}

.protein-card {
  background: linear-gradient(180deg, rgba(238, 246, 244, 0.92), rgba(255, 255, 255, 0.94));
}

.fat-card {
  background: linear-gradient(180deg, rgba(255, 248, 237, 0.92), rgba(255, 255, 255, 0.94));
}

.carbs-card {
  background: linear-gradient(180deg, rgba(241, 248, 252, 0.92), rgba(255, 255, 255, 0.94));
}

.entry-panel {
  padding: 28rpx;
}

.entry-panel-copy {
  flex: 1;
  min-width: 0;
}

.entry-panel-action {
  min-width: 170rpx;
}

.entry-panel-hint {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx dashed rgba(168, 214, 205, 0.9);
}

.goal-card {
  padding: 26rpx 28rpx;
  background:
    radial-gradient(circle at top right, rgba(111, 191, 151, 0.16), transparent 32%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(248, 252, 250, 0.98));
}

.body-type-card {
  padding: 26rpx 28rpx;
  background:
    radial-gradient(circle at top right, rgba(124, 184, 214, 0.14), transparent 30%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(247, 251, 252, 0.98));
}

.body-type-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.body-type-grid {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
}

.body-type-item {
  flex: 1;
  padding: 20rpx 22rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.86);
  border: 1rpx solid rgba(217, 232, 228, 0.92);
}

.body-type-label {
  display: block;
  font-size: 22rpx;
  color: var(--text-hint);
}

.body-type-value {
  display: block;
  margin-top: 10rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.4;
}

.goal-card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.goal-card-copy {
  flex: 1;
  min-width: 0;
}

.goal-card-action {
  flex-shrink: 0;
  min-width: 160rpx;
  min-height: 88rpx;
  padding: 0 28rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(244, 251, 249, 0.98));
  border-color: rgba(168, 214, 205, 0.92);
  color: #5F9D98;
  box-shadow: 0 10rpx 24rpx rgba(95, 157, 152, 0.1);
  transition: transform 0.16s ease, box-shadow 0.16s ease, background 0.16s ease, border-color 0.16s ease, opacity 0.16s ease;
  animation: goalButtonPulse 2.2s ease-in-out infinite;
}

.goal-card-action:active {
  transform: translateY(3rpx) scale(0.975);
  background: linear-gradient(180deg, rgba(232, 246, 242, 0.98), rgba(223, 241, 236, 0.98));
  border-color: rgba(125, 193, 177, 0.96);
  box-shadow: 0 6rpx 16rpx rgba(95, 157, 152, 0.18);
  opacity: 0.94;
}

.goal-card-hint {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx dashed rgba(168, 214, 205, 0.9);
}

.goal-card-hint-dot {
  width: 14rpx;
  height: 14rpx;
  margin-top: 9rpx;
  border-radius: 50%;
  background: #4EAE7D;
  box-shadow: 0 0 0 6rpx rgba(78, 174, 125, 0.14);
  flex-shrink: 0;
}

.goal-card-hint-text {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--text-secondary);
}

@keyframes goalButtonPulse {
  0%, 100% {
    box-shadow: 0 10rpx 24rpx rgba(95, 157, 152, 0.1);
  }
  50% {
    box-shadow: 0 14rpx 30rpx rgba(95, 157, 152, 0.16);
  }
}

.entry-panel-header {
  margin-bottom: 18rpx;
}

.scan-mode-card {
  margin-bottom: 18rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, rgba(244, 248, 247, 0.86), rgba(255, 255, 255, 0.98));
  border: 1rpx solid rgba(217, 232, 228, 0.92);
}

.scan-mode-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.scan-mode-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.75;
  color: var(--text-secondary);
}

.scan-mode-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 16rpx;
}

.scan-mode-option {
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(217, 232, 228, 0.92);
  transition: transform 0.16s ease, background 0.16s ease, border-color 0.16s ease, box-shadow 0.16s ease;
}

.scan-mode-option:active {
  transform: translateY(2rpx) scale(0.985);
}

.scan-mode-option.active {
  background: linear-gradient(180deg, rgba(232, 246, 242, 0.98), rgba(248, 252, 250, 0.98));
  border-color: rgba(125, 193, 177, 0.92);
  box-shadow: 0 10rpx 24rpx rgba(95, 157, 152, 0.1);
}

.scan-mode-option-title {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.scan-mode-option-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--text-secondary);
}

.entry-actions {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.entry-action {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx 22rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(247, 251, 250, 0.98));
  border: 1rpx solid rgba(217, 232, 228, 0.92);
  box-shadow: 0 10rpx 28rpx rgba(52, 92, 89, 0.05);
}

.entry-action:active {
  transform: translateY(2rpx) scale(0.985);
  box-shadow: 0 8rpx 18rpx rgba(52, 92, 89, 0.08);
}

.entry-action-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  gap: 4rpx;
}

.entry-action-icon-label {
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
}

.soft-rose {
  background: rgba(217, 120, 120, 0.14);
  color: var(--primary-color-strong);
}

.soft-blue {
  background: rgba(124, 184, 214, 0.18);
  color: #2F6C8C;
}

.soft-mint {
  background: rgba(111, 191, 151, 0.18);
  color: #4B8F72;
}

.icon-camera {
  position: relative;
  width: 28rpx;
  height: 18rpx;
  border: 3rpx solid currentColor;
  border-radius: 8rpx;
}

.icon-camera::before {
  content: '';
  position: absolute;
  top: -7rpx;
  left: 4rpx;
  width: 10rpx;
  height: 6rpx;
  border: 3rpx solid currentColor;
  border-bottom: none;
  border-radius: 6rpx 6rpx 0 0;
  background: transparent;
}

.icon-camera-lens {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 8rpx;
  height: 8rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

.icon-album {
  position: relative;
  width: 28rpx;
  height: 22rpx;
}

.icon-album-card {
  position: absolute;
  width: 18rpx;
  height: 14rpx;
  border: 3rpx solid currentColor;
  border-radius: 6rpx;
}

.icon-album-back {
  top: 2rpx;
  left: 2rpx;
  opacity: 0.45;
}

.icon-album-front {
  right: 2rpx;
  bottom: 2rpx;
  background: transparent;
}

.icon-pencil {
  position: relative;
  width: 28rpx;
  height: 18rpx;
  transform: rotate(-18deg);
}

.icon-pencil-body {
  position: absolute;
  top: 6rpx;
  left: 2rpx;
  width: 18rpx;
  height: 5rpx;
  border-radius: 999rpx;
  background: currentColor;
}

.icon-pencil-tip {
  position: absolute;
  top: 5rpx;
  right: 1rpx;
  width: 0;
  height: 0;
  border-top: 4rpx solid transparent;
  border-bottom: 4rpx solid transparent;
  border-left: 8rpx solid currentColor;
}

.entry-action-copy {
  flex: 1;
  min-width: 0;
}

.entry-action-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.entry-action-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: var(--text-secondary);
}

.scan-result {
  padding: 30rpx 28rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(250, 252, 251, 0.98));
}

.result-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.result-header-copy {
  flex: 1;
  min-width: 0;
}

.result-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.result-badge {
  font-size: 20rpx;
}

.estimate-badge {
  letter-spacing: 1rpx;
}

.result-title {
  display: block;
  margin-top: 14rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.result-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: var(--text-secondary);
}

.result-close,
.form-close,
.food-card-delete {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(244, 248, 247, 0.92);
  color: var(--text-secondary);
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
  transition: transform 0.16s ease, background 0.16s ease, color 0.16s ease;
}

.result-close:active,
.form-close:active,
.food-card-delete:active {
  transform: scale(0.96);
  background: rgba(231, 239, 237, 0.98);
  color: var(--text-primary);
}

.result-preview {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 22rpx;
}

.result-image-wrap {
  border-radius: 24rpx;
  overflow: hidden;
  background: rgba(238, 246, 244, 0.72);
}

.result-image {
  width: 100%;
  height: 320rpx;
  display: block;
}

.result-summary {
  padding: 22rpx;
  border-radius: 22rpx;
  background: rgba(244, 248, 247, 0.86);
  border: 1rpx solid rgba(217, 232, 228, 0.92);
}

.result-food-name {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.4;
}

.result-summary-note {
  display: block;
  margin-top: 10rpx;
  font-size: 23rpx;
  color: var(--text-secondary);
  line-height: 1.8;
}

.result-nutrition-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 22rpx;
}

.result-nutrition-grid.compact {
  margin-top: 16rpx;
}

.result-nutrition-card {
  width: calc(50% - 7rpx);
  padding: 22rpx 20rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(217, 232, 228, 0.92);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.92);
}

.rn-label {
  display: block;
  font-size: 22rpx;
  color: var(--text-hint);
}

.rn-value {
  display: block;
  margin-top: 12rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.rn-unit {
  display: block;
  margin-top: 8rpx;
  font-size: 21rpx;
  color: var(--text-secondary);
}

.cal-value {
  color: var(--primary-color-strong);
}

.protein-value {
  color: #4B8F72;
}

.fat-value {
  color: #B17D4C;
}

.carb-value {
  color: #2F6C8C;
}

.estimate-note {
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #FFF9ED 0%, #FFFDF7 100%);
  border: 1rpx solid rgba(230, 179, 106, 0.2);
}

.low-confidence-note {
  background: linear-gradient(180deg, #FFF4EC 0%, #FFF9F5 100%);
}

.estimate-note-label {
  display: block;
  font-size: 21rpx;
  font-weight: 700;
  color: #B17D4C;
  letter-spacing: 1rpx;
}

.estimate-note-text {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.75;
  color: #8B7355;
}

.result-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 24rpx;
}

.rescan-tip {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, rgba(241, 248, 252, 0.95), rgba(255, 255, 255, 0.98));
  border: 1rpx solid rgba(124, 184, 214, 0.24);
}

.rescan-tip-copy {
  flex: 1;
  min-width: 0;
}

.rescan-tip-title {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: #2F6C8C;
}

.rescan-tip-text {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--text-secondary);
}

.rescan-tip-action {
  flex-shrink: 0;
  min-width: 150rpx;
}

.scan-food-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 20rpx;
}

.scan-food-card {
  padding: 22rpx;
  border-radius: 24rpx;
  background: rgba(244, 248, 247, 0.86);
  border: 1rpx solid rgba(217, 232, 228, 0.92);
}

.scan-food-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.scan-food-name {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.scan-food-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.scan-food-edit {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(124, 184, 214, 0.14);
  color: #2F6C8C;
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
  transition: transform 0.16s ease, background 0.16s ease, color 0.16s ease;
}

.scan-food-edit:active {
  transform: scale(0.96);
  background: rgba(124, 184, 214, 0.22);
  color: #24546d;
}

.portion-section {
  margin-top: 18rpx;
}

.portion-label {
  display: block;
  font-size: 22rpx;
  color: var(--text-secondary);
  font-weight: 600;
}

.portion-options {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.portion-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 64rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.84);
  border: 1rpx solid rgba(217, 232, 228, 0.92);
  color: var(--text-secondary);
  font-size: 22rpx;
  font-weight: 600;
  transition: transform 0.16s ease, background 0.16s ease, border-color 0.16s ease, color 0.16s ease;
}

.portion-chip.active {
  background: rgba(217, 120, 120, 0.14);
  border-color: rgba(217, 120, 120, 0.22);
  color: var(--primary-color-strong);
}

.portion-chip:active {
  transform: scale(0.96);
  background: rgba(247, 249, 248, 0.96);
}

.custom-grams-input {
  margin-top: 12rpx;
}

.result-total {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid rgba(217, 232, 228, 0.92);
}

.result-total-title {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-secondary);
}

.result-total-text {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-primary);
  line-height: 1.65;
}

.result-action-secondary,
.result-action-primary,
.manual-cancel,
.manual-submit {
  flex: 1;
}

.manual-form {
  padding: 30rpx 28rpx;
}

.form-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.form-header-copy {
  flex: 1;
  min-width: 0;
}

.form-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.form-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.75;
  color: var(--text-secondary);
}

.form-shell {
  margin-top: 22rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, rgba(250, 252, 251, 0.96), rgba(255, 255, 255, 0.98));
  border: 1rpx solid rgba(217, 232, 228, 0.92);
}

.manual-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.form-group {
  width: calc(50% - 7rpx);
  margin-bottom: 0;
}

.form-group-full {
  width: 100%;
  margin-bottom: 18rpx;
}

.form-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 23rpx;
  color: var(--text-secondary);
  font-weight: 600;
}

.nutrition-input-placeholder {
  color: #9AAEAC;
  font-size: 30rpx;
}

.manual-form .input-field,
.goal-modal .input-field {
  min-height: 100rpx;
  padding: 0 28rpx;
  font-size: 32rpx;
  line-height: 100rpx;
  border-width: 2rpx;
  border-color: rgba(203, 222, 218, 0.96);
  background: rgba(255, 255, 255, 0.98);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.92);
}

.manual-form .input-field:focus,
.goal-modal .input-field:focus {
  border-color: rgba(125, 193, 177, 0.96);
  box-shadow: 0 0 0 6rpx rgba(125, 193, 177, 0.12);
}

.manual-tip {
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: rgba(238, 246, 244, 0.76);
  border: 1rpx solid rgba(217, 232, 228, 0.92);
}

.manual-tip-label {
  display: block;
  font-size: 21rpx;
  font-weight: 700;
  color: var(--text-secondary);
  letter-spacing: 1rpx;
}

.manual-tip-text {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.75;
  color: var(--text-secondary);
}

.form-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 24rpx;
}

.today-foods {
  margin-top: 8rpx;
}

.food-log-header {
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.section-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: var(--text-secondary);
}

.food-card {
  padding: 22rpx;
  background:
    radial-gradient(circle at top right, rgba(124, 184, 214, 0.1), transparent 28%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.99), rgba(249, 252, 251, 0.97));
}

.food-card-main {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.food-card-image,
.food-card-placeholder {
  width: 116rpx;
  height: 116rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
}

.food-card-image {
  display: block;
}

.food-card-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, rgba(238, 246, 244, 0.88), rgba(244, 248, 247, 0.92));
  color: var(--text-secondary);
  font-size: 22rpx;
  font-weight: 600;
}

.food-card-info {
  flex: 1;
  min-width: 0;
}

.food-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.food-card-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.45;
}

.food-card-state {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(111, 191, 151, 0.15);
  color: #4B8F72;
  font-size: 20rpx;
  font-weight: 700;
}

.food-card-note {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.7;
}

.food-card-macros {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 14rpx;
}

.macro-tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  font-weight: 700;
}

.food-card-delete {
  min-width: 88rpx;
  min-height: 52rpx;
  padding: 10rpx 14rpx;
  border-radius: 18rpx;
  background: rgba(244, 248, 247, 0.96);
  border: 1rpx solid rgba(217, 232, 228, 0.92);
  color: var(--text-secondary);
  font-size: 22rpx;
  font-weight: 600;
}

.cal-tag {
  background: rgba(217, 120, 120, 0.12);
  color: var(--primary-color-strong);
}

.protein-tag {
  background: rgba(111, 191, 151, 0.15);
  color: #4B8F72;
}

.fat-tag {
  background: rgba(230, 179, 106, 0.14);
  color: #B17D4C;
}

.carb-tag {
  background: rgba(124, 184, 214, 0.16);
  color: #2F6C8C;
}

.food-log-empty {
  padding: 40rpx 32rpx;
  text-align: center;
}

.food-log-empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.food-log-empty-text {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.8;
  color: var(--text-secondary);
}

.page-spacer {
  height: calc(env(safe-area-inset-bottom) + 120rpx);
}

.modal-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1200;
  padding: 24rpx;
  box-sizing: border-box;
  background: rgba(18, 24, 32, 0.42);
  backdrop-filter: blur(10rpx);
}

.guide-mask {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: calc(env(safe-area-inset-bottom) + 22rpx);
}

.guide-modal {
  width: 100%;
  box-sizing: border-box;
}

.guide-modal-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 22rpx;
}

.guide-title-wrap {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.guide-caption {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: var(--text-hint);
  text-transform: uppercase;
}

.guide-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.35;
}

.guide-close {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 96rpx;
  min-height: 56rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(244, 248, 247, 0.96);
  border: 1rpx solid rgba(217, 232, 228, 0.92);
  color: var(--text-secondary);
  font-size: 22rpx;
  font-weight: 600;
}

.guide-close:active {
  transform: scale(0.96);
  background: rgba(231, 239, 237, 0.98);
  color: var(--text-primary);
}

.goal-modal {
  max-height: 86vh;
}

.form-sheet-modal {
  width: 100%;
  max-height: 80vh;
  padding: 32rpx 32rpx 26rpx;
  box-sizing: border-box;
  border-radius: 32rpx 32rpx 0 0;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.99), rgba(249, 252, 251, 0.98));
  box-shadow: 0 -18rpx 44rpx rgba(52, 92, 89, 0.16);
  overflow: hidden;
  align-self: flex-end;
}

.sheet-scroll {
  max-height: 52vh;
  padding-bottom: 28rpx;
  box-sizing: border-box;
}

.sheet-footer-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(217, 232, 228, 0.92);
}

.sheet-entry-actions {
  margin-top: 0;
}

.goal-form-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.goal-form-grid .form-group {
  width: 100%;
}

.goal-form-grid .form-group:last-child {
  width: 100%;
}

.goal-selector {
  margin-top: 18rpx;
}

.selector-chip-row {
  display: flex;
  gap: 10rpx;
  margin-top: 12rpx;
}

.selector-chip-row.wrap {
  flex-wrap: wrap;
}

.selector-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(244, 248, 247, 0.86);
  border: 1rpx solid rgba(217, 232, 228, 0.92);
  color: var(--text-secondary);
  font-size: 24rpx;
  font-weight: 600;
  transition: transform 0.16s ease, background 0.16s ease, border-color 0.16s ease, color 0.16s ease, box-shadow 0.16s ease;
}

.selector-chip.active {
  background: rgba(217, 120, 120, 0.14);
  border-color: rgba(217, 120, 120, 0.22);
  color: var(--primary-color-strong);
  box-shadow: 0 10rpx 20rpx rgba(217, 120, 120, 0.1);
}

.selector-chip:active {
  transform: scale(0.965);
  background: rgba(235, 242, 240, 0.96);
  border-color: rgba(190, 214, 209, 0.96);
}

.manual-cancel,
.manual-submit,
.result-action-secondary,
.result-action-primary {
  min-height: 92rpx;
}

.manual-cancel:active,
.manual-submit:active,
.result-action-secondary:active,
.result-action-primary:active {
  transform: translateY(2rpx) scale(0.985);
}
