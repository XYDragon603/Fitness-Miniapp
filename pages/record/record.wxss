.air-record-header {
  padding-bottom: 24rpx;
}

.session-summary {
  padding: 30rpx 30rpx 28rpx;
  background:
    radial-gradient(circle at top right, rgba(124, 184, 214, 0.14), transparent 34%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(249, 252, 251, 0.96));
}

.session-summary-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.session-copy {
  flex: 1;
  min-width: 0;
}

.session-label {
  display: block;
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: var(--text-hint);
}

.session-day {
  display: block;
  margin-top: 14rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.4;
}

.session-progress {
  min-width: 148rpx;
  padding: 16rpx 18rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.84);
  border: 1rpx solid rgba(217, 232, 228, 0.92);
  text-align: center;
  box-shadow: 0 10rpx 24rpx rgba(52, 92, 89, 0.08);
}

.session-progress-value {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--primary-color-strong);
  line-height: 1.1;
}

.session-progress-label {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--text-hint);
}

.session-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
}

.session-pill {
  min-width: 180rpx;
  padding: 14rpx 18rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.8);
  border: 1rpx solid rgba(217, 232, 228, 0.92);
}

.session-pill-label {
  display: block;
  font-size: 20rpx;
  color: var(--text-hint);
}

.session-pill-value {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.session-caption {
  display: block;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.8;
}

.day-selector {
  margin-bottom: 24rpx;
}

.selector-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
  padding: 0 6rpx;
}

.selector-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 600;
}

.selector-note {
  font-size: 22rpx;
  color: var(--text-hint);
}

.selector-options {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.selector-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.84);
  border: 1rpx solid rgba(217, 232, 228, 0.92);
  box-shadow: 0 10rpx 28rpx rgba(52, 92, 89, 0.06);
  transition: all 0.3s ease;
}

.selector-item.active {
  box-shadow: 0 16rpx 34rpx rgba(52, 92, 89, 0.1);
  transform: translateY(-2rpx);
}

.selector-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.selector-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: rgba(25, 53, 59, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.selector-icon {
  font-size: 34rpx;
}

.selector-copy {
  flex: 1;
  min-width: 0;
}

.selector-name {
  display: block;
  font-size: 27rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.5;
}

.selector-state {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-hint);
}

.selector-arrow {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--text-hint);
  font-weight: 600;
}

.progress-section {
  padding: 24rpx 28rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.94), rgba(247, 251, 250, 0.96));
}

.rest-checkin {
  padding: 30rpx 30rpx 32rpx;
  background: linear-gradient(180deg, #FCFEFD 0%, #F4FBF8 100%);
  border: 1rpx solid rgba(143, 184, 170, 0.24);
}

.rest-checkin-header {
  margin-bottom: 22rpx;
}

.rest-checkin-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.rest-checkin-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.75;
}

.rest-switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.84);
  border: 1rpx solid rgba(217, 232, 228, 0.92);
}

.rest-switch-label,
.rest-section-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.rest-feeling-group,
.rest-note-group {
  margin-top: 18rpx;
}

.rest-feeling-options {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.rest-feeling-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.84);
  border: 1rpx solid rgba(217, 232, 228, 0.92);
  color: var(--text-secondary);
  font-size: 22rpx;
  font-weight: 600;
}

.rest-feeling-chip.active {
  background: rgba(95, 154, 136, 0.18);
  border-color: rgba(95, 154, 136, 0.48);
  color: #426F62;
}

.rest-note-input {
  width: 100%;
  min-height: 180rpx;
  margin-top: 14rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 2rpx solid rgba(203, 222, 218, 0.96);
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--text-primary);
}

.rest-hint-card {
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
  border-radius: 22rpx;
  background: rgba(143, 184, 170, 0.12);
}

.rest-hint-text {
  display: block;
  font-size: 23rpx;
  line-height: 1.75;
  color: #5D7F74;
}

.progress-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 18rpx;
}

.progress-copy {
  flex: 1;
  min-width: 0;
}

.progress-label {
  display: block;
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 600;
}

.progress-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-hint);
  line-height: 1.6;
}

.progress-value {
  flex-shrink: 0;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--success-color);
}

.progress-fill {
  background: linear-gradient(90deg, #72C394, #4EAE7D);
}

.exercise-record-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.exercise-record-card {
  padding: 0;
  overflow: hidden;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(249, 252, 251, 0.96));
}

.exercise-record-card.completed {
  border-color: rgba(111, 191, 151, 0.44);
  box-shadow: 0 16rpx 34rpx rgba(111, 191, 151, 0.14);
}

.record-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 28rpx 26rpx 22rpx;
}

.record-main {
  flex: 1;
  min-width: 0;
}

.record-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  align-items: center;
}

.record-order,
.record-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.record-order {
  min-width: 54rpx;
  height: 54rpx;
  padding: 0 14rpx;
}

.record-chip {
  padding: 8rpx 16rpx;
  background: rgba(25, 53, 59, 0.06);
  color: var(--text-secondary);
  font-weight: 600;
}

.record-name {
  display: block;
  margin-top: 18rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.45;
}

.record-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--text-secondary);
  line-height: 1.7;
}

.complete-toggle {
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  border: 2rpx solid rgba(137, 160, 166, 0.34);
  background: rgba(255, 255, 255, 0.84);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.3s ease;
}

.complete-toggle.checked {
  background: var(--success-color);
  border-color: var(--success-color);
  color: #FFFFFF;
  box-shadow: 0 10rpx 24rpx rgba(111, 191, 151, 0.24);
}

.record-meta {
  padding: 0 26rpx 18rpx;
}

.previous-summary {
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(238, 246, 244, 0.72);
  border: 1rpx solid rgba(217, 232, 228, 0.92);
}

.summary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.summary-label {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-secondary);
}

.summary-date {
  font-size: 20rpx;
  color: var(--text-hint);
}

.summary-text {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-primary);
  line-height: 1.6;
}

.record-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.action-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(208, 103, 103, 0.16);
  color: var(--primary-color-strong);
  font-size: 22rpx;
  font-weight: 700;
  border: 1rpx solid rgba(185, 82, 82, 0.18);
}

.action-chip.ghost {
  background: rgba(79, 156, 196, 0.16);
  color: #215E7E;
  border: 1rpx solid rgba(79, 156, 196, 0.18);
}

.suggestion-banner {
  margin-top: 14rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: linear-gradient(180deg, #FFF9ED 0%, #FFF5E3 100%);
  border: 1rpx solid rgba(230, 179, 106, 0.24);
  color: #8B6B1F;
}

.suggestion-title {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
}

.suggestion-text {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.7;
}

.sets-shell {
  padding: 0 20rpx 22rpx;
}

.sets-container {
  padding: 18rpx 18rpx 10rpx;
  border-radius: 26rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, #F7FBFA 100%);
  border: 1rpx solid rgba(217, 232, 228, 0.95);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}

.sets-header {
  display: flex;
  align-items: center;
  padding: 12rpx 4rpx 16rpx;
  border-bottom: 1rpx solid rgba(217, 232, 228, 0.92);
}

.sets-col {
  text-align: center;
  font-size: 21rpx;
  color: var(--text-hint);
  font-weight: 600;
}

.col-set {
  width: 64rpx;
}

.col-weight,
.col-reps {
  flex: 1;
}

.col-done {
  width: 86rpx;
}

.set-row {
  display: flex;
  align-items: center;
  padding: 16rpx 4rpx;
  border-bottom: 1rpx solid rgba(217, 232, 228, 0.52);
}

.set-row:last-child {
  border-bottom: none;
}

.set-number {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-secondary);
}

.set-input {
  width: 100%;
  padding: 14rpx 0;
  background: rgba(244, 248, 247, 0.9);
  border-radius: 14rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
  text-align: center;
}

.set-control-stack {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.set-picker {
  width: 100%;
  padding: 14rpx 0;
  background: rgba(244, 248, 247, 0.9);
  border-radius: 14rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-hint);
  text-align: center;
  border: 1rpx solid rgba(217, 232, 228, 0.92);
}

.set-picker.selected {
  color: var(--text-primary);
  background: #FFFFFF;
  border-color: rgba(168, 214, 205, 0.96);
}

.set-mode-toggle {
  font-size: 18rpx;
  color: #2F6C8C;
  text-align: center;
  line-height: 1.3;
}

.set-check {
  width: 46rpx;
  height: 46rpx;
  border-radius: 14rpx;
  border: 2rpx solid rgba(137, 160, 166, 0.34);
  background: rgba(255, 255, 255, 0.86);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  transition: all 0.3s ease;
}

.set-check.checked {
  background: var(--success-color);
  border-color: var(--success-color);
  color: #FFFFFF;
  box-shadow: 0 10rpx 22rpx rgba(111, 191, 151, 0.18);
}

.record-tip {
  margin: 0 20rpx 22rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: linear-gradient(180deg, #FFFCF6 0%, #FFF7EB 100%);
  border: 1rpx solid rgba(230, 179, 106, 0.18);
}

.tip-label {
  display: block;
  font-size: 20rpx;
  font-weight: 700;
  color: #B17D4C;
  letter-spacing: 1rpx;
}

.tip-text {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8B7355;
  line-height: 1.75;
}

.record-empty {
  margin-top: 8rpx;
  padding: 72rpx 34rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.84);
  border: 1rpx solid rgba(217, 232, 228, 0.92);
  box-shadow: 0 12rpx 30rpx rgba(52, 92, 89, 0.08);
}

.record-empty .empty-icon {
  font-size: 92rpx;
}

.empty-title {
  margin-top: 14rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.record-empty .empty-text {
  margin-top: 12rpx;
  color: var(--text-secondary);
  line-height: 1.8;
}

.save-section {
  position: sticky;
  bottom: 0;
  padding: 20rpx 0;
  background: linear-gradient(180deg, rgba(244, 248, 247, 0) 0%, rgba(244, 248, 247, 0.92) 28%, rgba(244, 248, 247, 1) 100%);
}

.save-btn {
  width: 100%;
  padding: 28rpx 0;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 20rpx;
  letter-spacing: 2rpx;
}

.modal-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1200;
  padding: 24rpx;
  box-sizing: border-box;
  background: rgba(17, 20, 35, 0.5);
}

.guide-mask {
  display: flex;
  align-items: center;
  justify-content: center;
}

.guide-modal {
  width: 100%;
  max-height: 82vh;
  padding: 32rpx;
  box-sizing: border-box;
  border-radius: 30rpx;
  background: #FFFFFF;
  box-shadow: 0 18rpx 60rpx rgba(0, 0, 0, 0.18);
  overflow-y: auto;
}

.guide-modal-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.guide-title-wrap {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.guide-caption {
  font-size: 22rpx;
  color: var(--text-hint);
}

.guide-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.guide-close {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #F3F7F6;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.guide-section,
.guide-video-card {
  margin-top: 24rpx;
}

.guide-section-title {
  display: block;
  margin-bottom: 12rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.guide-summary {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.7;
}

.guide-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.guide-list-item {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
}

.guide-bullet {
  font-size: 24rpx;
  color: var(--primary-color);
  line-height: 1.5;
}

.guide-list-text {
  flex: 1;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.guide-video-card {
  padding: 24rpx;
  border-radius: 20rpx;
  background: rgba(238, 246, 244, 0.72);
  border: 1rpx solid rgba(217, 232, 228, 0.92);
}

.guide-video-title {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.guide-video-url {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #2F6C8C;
  line-height: 1.6;
  word-break: break-all;
}

.guide-video-action {
  margin-top: 16rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(79, 156, 196, 0.16);
  color: #215E7E;
  font-size: 22rpx;
  font-weight: 700;
  border: 1rpx solid rgba(79, 156, 196, 0.2);
}

.rest-timer-mask {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: calc(env(safe-area-inset-bottom) + 56rpx);
}

.rest-timer-card {
  width: 100%;
  padding: 32rpx 28rpx 36rpx;
  box-sizing: border-box;
  border-radius: 30rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, #F9FCFB 100%);
  box-shadow: 0 18rpx 60rpx rgba(0, 0, 0, 0.18);
}

.rest-timer-caption {
  display: block;
  font-size: 22rpx;
  color: var(--text-hint);
}

.rest-timer-title {
  display: block;
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.rest-timer-count {
  display: block;
  margin-top: 22rpx;
  font-size: 88rpx;
  line-height: 1;
  font-weight: 800;
  color: var(--primary-color-strong);
}

.rest-timer-hint {
  display: block;
  margin-top: 18rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.7;
}

.rest-timer-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.rest-action-btn {
  flex: 1;
}

.page-spacer {
  height: 120rpx;
}
