

.workout { min-height: 100vh; background: #0E1416; }
.lime-text { color: var(--lime); font-weight: 800; }

/* 选择训练日 */
.pick-day { display: flex; align-items: center; gap: 24rpx; padding: 30rpx 28rpx; margin-bottom: 16rpx; }
.pick-day:active { background: var(--dark-3); }
.pick-day-index { width: 56rpx; height: 56rpx; border-radius: 28rpx; background: var(--dark-3); color: var(--lime); display: flex; align-items: center; justify-content: center; font-weight: 800; }
.pick-day-name { flex: 1; font-size: 32rpx; font-weight: 700; color: #FFFFFF; }

/* 进度 */
.progress-row { display: flex; align-items: center; gap: 28rpx; padding: 12rpx 0 8rpx; }
.progress-count { font-size: 34rpx; color: #FFFFFF; font-weight: 700; flex-shrink: 0; }
.progress-current { font-size: 46rpx; font-weight: 800; }
.progress-track { flex: 1; height: 14rpx; }

/* 动作头部 */
.ex-head { display: flex; align-items: center; gap: 16rpx; margin: 26rpx 0 30rpx; }
.ex-copy { flex: 1; min-width: 0; }
.ex-name { font-size: 70rpx; line-height: 1.15; font-weight: 800; color: #FFFFFF; }
.ex-plan { margin-top: 10rpx; font-size: 40rpx; color: #D6DBDD; }
.ex-last { margin-top: 12rpx; font-size: 32rpx; color: var(--dark-text-2); }
.ex-image { width: 300rpx; height: 236rpx; flex-shrink: 0; }
.ex-gif.media { width: 248rpx; height: 248rpx; border-radius: 24rpx; }

.ex-actions { display: flex; gap: 20rpx; }
.ex-action { flex: 1; justify-content: flex-start; padding: 0 24rpx; height: 108rpx; }
.ex-action-text { flex: 1; font-size: 30rpx; }

/* 组表格 */
.sets-head { display: flex; align-items: center; padding: 40rpx 0 18rpx; font-size: 26rpx; color: var(--dark-text-2); }
.col-set { width: 64rpx; text-align: center; flex-shrink: 0; }
.col-step { flex: 1; text-align: center; margin: 0 8rpx; }
.col-done { width: 76rpx; flex-shrink: 0; display: flex; justify-content: center; text-align: center; }

.set-row { display: flex; align-items: center; height: 124rpx; padding: 0 6rpx; margin-bottom: 16rpx; border-radius: 22rpx; background: var(--dark); border: 3rpx solid transparent; }
.set-row.is-current { border-color: var(--lime); background: #151F1B; }
.set-no { font-size: 40rpx; font-weight: 700; color: #FFFFFF; }
.set-row.is-current .set-no { color: var(--lime); }

.stepper { display: flex; align-items: center; height: 84rpx; border-radius: 16rpx; background: var(--dark-2); border: 2rpx solid var(--dark-line); }
.set-row.is-current .stepper { border-color: rgba(200, 247, 110, 0.75); }
.step-btn { width: 64rpx; height: 84rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.step-btn:active { opacity: 0.5; }
.step-input { flex: 1; min-width: 0; height: 84rpx; text-align: center; font-size: 36rpx; font-weight: 700; color: #FFFFFF; }
.step-placeholder { color: #59646A; font-weight: 500; }

.done-icon { width: 56rpx; height: 56rpx; }
.done-ring { width: 52rpx; height: 52rpx; border-radius: 50%; border: 3rpx solid #C9CED0; }
.set-row.is-current .done-ring { border-color: #FFFFFF; }

/* 全屏覆盖层 */
.overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 300; background: #0E1416; overflow-y: auto; }

/* 组间休息 */
.rest-caption { text-align: center; font-size: 30rpx; color: #D6DBDD; margin-top: 8rpx; }
.rest-ring { position: relative; width: 620rpx; height: 620rpx; margin: 24rpx auto 8rpx; }
.rest-ring-img { width: 620rpx; height: 620rpx; }
.rest-ring-center { position: absolute; top: 0; left: 0; right: 0; bottom: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.rest-ring-label { font-size: 36rpx; color: #D6DBDD; }
.rest-ring-time { font-size: 168rpx; line-height: 1.1; font-weight: 800; color: #FFFFFF; letter-spacing: -4rpx; }
.rest-ring-time.done { font-size: 64rpx; color: var(--lime); margin: 24rpx 0; letter-spacing: 0; }
.rest-ring-next-label { font-size: 30rpx; color: #D6DBDD; margin-top: 12rpx; }
.rest-ring-next { font-size: 40rpx; font-weight: 800; color: #FFFFFF; }

.rest-actions { display: flex; gap: 20rpx; margin-top: 24rpx; }
.rest-action { flex: 1; height: 196rpx; border-radius: 24rpx; background: var(--dark); border: 2rpx solid var(--dark-line); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14rpx; font-size: 30rpx; color: #FFFFFF; font-weight: 700; }
.rest-action:active { background: var(--dark-3); }
.rest-head { margin: 40rpx 0 18rpx; }
.rest-head-title { font-size: 30rpx; font-weight: 700; color: #FFFFFF; }
.presets { display: flex; gap: 14rpx; padding: 14rpx; border-radius: 24rpx; background: var(--dark); }
.preset { flex: 1; height: 116rpx; border-radius: 18rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; border: 3rpx solid transparent; }
.preset.active { border-color: var(--lime); background: #1A2419; }
.preset-num { font-size: 38rpx; font-weight: 800; color: #FFFFFF; }
.preset.active .preset-num, .preset.active .preset-unit { color: var(--lime); }
.preset-unit { font-size: 20rpx; color: var(--dark-text-2); }
.rest-next { display: flex; align-items: center; margin-top: 28rpx; padding: 28rpx 28rpx 28rpx 32rpx; }
.rest-next-copy { flex: 1; display: flex; flex-direction: column; gap: 6rpx; }
.rest-next-name { font-size: 46rpx; font-weight: 800; color: #FFFFFF; }
.rest-next-meta { font-size: 32rpx; color: #D6DBDD; }
.rest-next-image { width: 240rpx; height: 170rpx; }
.rest-next-image.media.small { width: 170rpx; height: 170rpx; border-radius: 18rpx; }

/* 下一组目标 */
.target .ex-head { margin-top: 20rpx; }
.compare { display: flex; align-items: center; gap: 10rpx; }
.compare-card { flex: 1; min-width: 0; padding: 28rpx 24rpx; display: flex; flex-direction: column; gap: 8rpx; }
.compare-card.is-now { border-color: rgba(200, 247, 110, 0.25); }
.compare-label-row { display: flex; align-items: center; justify-content: space-between; }
.compare-now-label { font-size: 26rpx; color: var(--lime); font-weight: 700; }
.compare-value { font-size: 50rpx; font-weight: 800; color: #FFFFFF; white-space: nowrap; }
.compare-value.muted { color: var(--dark-text-2); }
.compare-value .unit { font-size: 28rpx; font-weight: 600; }
.compare-date { font-size: 24rpx; color: var(--dark-text-3); }
.compare-arrow { width: 32rpx; height: 32rpx; flex-shrink: 0; }

.suggest { margin-top: 24rpx; padding: 32rpx; border-radius: 26rpx; border: 3rpx solid var(--lime); background: #121A17; }
.suggest-head { display: flex; align-items: center; gap: 14rpx; font-size: 36rpx; font-weight: 800; color: var(--lime); }
.suggest-value { margin-top: 16rpx; font-size: 104rpx; line-height: 1.1; font-weight: 800; color: var(--lime); }
.suggest-unit { font-size: 52rpx; }
.suggest-x { font-size: 52rpx; color: #FFFFFF; }
.suggest-text { margin-top: 12rpx; font-size: 30rpx; color: #D6DBDD; }

.pr { display: flex; align-items: center; gap: 20rpx; margin-top: 24rpx; padding: 30rpx 28rpx; }
.pr-icon { width: 64rpx; height: 64rpx; }
.pr-copy { flex: 1; display: flex; flex-direction: column; gap: 4rpx; padding-right: 20rpx; border-right: 2rpx solid var(--dark-line); }
.pr-title { font-size: 32rpx; font-weight: 800; color: #FFFFFF; }
.pr-desc { font-size: 24rpx; color: var(--dark-text-2); }
.pr-value { display: flex; flex-direction: column; align-items: flex-end; gap: 4rpx; }
.pr-gain { font-size: 54rpx; font-weight: 800; color: var(--lime); }
.pr-unit { font-size: 30rpx; }
.pr-new { font-size: 26rpx; color: var(--dark-text-2); }
.target-adopt { height: 104rpx; }

/* 教学 */
.guide-block { margin-bottom: 32rpx; }
.guide-title { font-size: 30rpx; font-weight: 800; color: var(--lime); margin-bottom: 12rpx; }
.guide-text { font-size: 28rpx; color: #D6DBDD; line-height: 1.7; }
.guide-chips { display: flex; flex-wrap: wrap; gap: 12rpx; }
.guide-chip { background: var(--dark-3); color: #FFFFFF; height: 48rpx; font-size: 24rpx; }
.guide-copy { margin-top: 16rpx; height: 88rpx; }

.empty-title.on-dark { color: #FFFFFF; }
.empty-text.on-dark { color: var(--dark-text-2); }
.empty-figure.dark-fig { background: var(--dark-2); }

/* ========== 恢复日（浅色） ========== */
.recovery { background: var(--bg); min-height: 100vh; }
.recovery-day { margin-top: 10rpx; font-size: 38rpx; font-weight: 800; color: var(--text); }
.recovery .hero-sub { margin-top: 6rpx; }
.recovery-card { min-height: 300rpx; padding: 36rpx; }
.recovery-card-title { position: relative; z-index: 1; margin-top: 10rpx; font-size: 84rpx; font-weight: 800; }
.recovery-card-text { position: relative; z-index: 1; width: 60%; margin-top: 10rpx; font-size: 30rpx; color: #D6DBDD; line-height: 1.6; }
.recovery-rings { position: absolute; right: -120rpx; top: -60rpx; width: 520rpx; height: 520rpx; border-radius: 50%; border: 2rpx solid rgba(255, 255, 255, 0.07); box-shadow: 0 0 0 50rpx rgba(255, 255, 255, 0.015), 0 0 0 100rpx rgba(255, 255, 255, 0.02); }
.recovery-moon { position: absolute; right: 60rpx; top: 50rpx; width: 150rpx; height: 150rpx; }

.feelings { display: flex; gap: 16rpx; }
.feeling { flex: 1; height: 300rpx; border-radius: 24rpx; background: var(--surface); border: 3rpx solid transparent; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; text-align: center; }
.feeling.active { background: var(--lime); border-color: var(--ink); }
.feeling-icon { width: 92rpx; height: 92rpx; margin-bottom: 6rpx; }
.feeling-title { font-size: 32rpx; font-weight: 800; color: var(--text); }
.feeling-desc { font-size: 23rpx; color: var(--text-2); line-height: 1.45; }
.feeling.active .feeling-desc { color: #2F3A1A; }

.checkin { display: flex; align-items: center; gap: 20rpx; margin-top: 28rpx; padding: 30rpx 28rpx; background: var(--surface); border-radius: var(--radius-lg); }
.checkin-copy { flex: 1; }
.checkin-title { font-size: 32rpx; font-weight: 800; }
.checkin-desc { margin-top: 4rpx; font-size: 25rpx; color: var(--text-2); }

.note-wrap { position: relative; }
.note-wrap .textarea { min-height: 220rpx; padding-bottom: 56rpx; }
.note-count { position: absolute; right: 24rpx; bottom: 18rpx; font-size: 24rpx; color: var(--text-3); }
.workout-tools { display: flex; justify-content: space-between; gap: 24rpx; color: #C8F76E; font-size: 24rpx; padding: 24rpx 0; }
.set-type { display: block; font-size: 18rpx; color: #A7B0B4; line-height: 1.2; }
.add-set { padding: 26rpx; text-align: center; color: #C8F76E; font-size: 26rpx; }
