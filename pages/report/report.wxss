.report-card{padding:40rpx 32rpx}.brand{font-size:24rpx;letter-spacing:5rpx;color:#C8F76E;font-weight:800}.report-title{font-size:54rpx;font-weight:800;line-height:1.3;margin:36rpx 0 18rpx;color:#F6F4EE}.report-date,.report-note{font-size:24rpx;color:#9CA5A8;line-height:1.7}.report-name{font-size:32rpx;font-weight:700;margin:28rpx 0;color:#F6F4EE}.volume-panel{background:#202A2F;padding:28rpx;border-radius:18rpx}.report-volume{font-size:88rpx;color:#C8F76E;font-weight:800;margin-top:20rpx}.report-volume text{font-size:30rpx}.report-grid{display:grid;grid-template-columns:1fr 1fr;gap:36rpx 20rpx;margin:40rpx 0}.report-value{color:#F6F4EE;font-size:36rpx;font-weight:700;margin-top:14rpx}.pr-name{font-size:25rpx;color:#C8F76E;margin:18rpx 0}.report-foot{font-size:30rpx;font-weight:700;color:#F6F4EE;margin-top:50rpx}.report-note{margin:24rpx 0}.error{color:#A34C3F}.older{margin:24rpx 0}.share-button{margin-top:12rpx}.share-canvas{position:fixed;left:-10000px;top:0;width:375px;height:560px;pointer-events:none}.report-page{padding-bottom:290rpx}
.footer-bar > button { flex: 1; min-width: 0; margin: 0; padding: 0 16rpx; font-size: 28rpx; line-height: 1.3; }
