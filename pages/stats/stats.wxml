<nav-bar back />
<view class="page stats">
  <view class="hero">
    <view class="hero-title">统计与个人纪录</view>
    <view class="hero-sub">用数据记录努力，看见更好的自己。</view>
  </view>

  <view class="dark-card st-card">
    <view class="st-top">
      <view>
        <text class="label-dark st-label">累计训练</text>
        <view class="st-total num">{{stats.totalDays || 0}}<text class="st-total-unit"> 天</text></view>
      </view>
      <view class="st-ring">
        <image class="st-ring-img" src="{{ring}}" />
        <view class="st-ring-center"><text class="st-ring-pct num">{{stats.completionRate || 0}}<text class="st-ring-sym">%</text></text><text class="st-ring-label">完成率</text></view>
      </view>
    </view>
    <view class="st-tiles">
      <view class="dark-tile st-tile">
        <text class="label-dark">完成动作</text>
        <view class="st-tile-row"><text class="st-tile-value num">{{stats.completedExercises || 0}}</text><image class="icon-lg" src="/images/icons/dumbbell-lime.svg" /></view>
      </view>
      <view class="dark-tile st-tile">
        <text class="label-dark">恢复</text>
        <view class="st-tile-row"><view class="st-tile-value num">{{stats.restDays || 0}}<text class="st-tile-unit"> 天</text></view><image class="icon-lg" src="/images/icons/leaf-lime.svg" /></view>
      </view>
    </view>
  </view>

  <view class="section-head">
    <text class="section-title">本周训练频次</text>
    <view class="section-link" bindtap="openHistory">查看详情<image class="icon" src="/images/icons/chevron-right-grey.svg" /></view>
  </view>
  <view class="st-week">
    <view class="st-week-col" wx:for="{{week}}" wx:key="date">
      <text class="st-week-count num">{{item.count}}</text>
      <view class="st-week-track"><view class="st-week-bar {{item.count ? 'on' : ''}}" style="height: {{item.count ? item.height : 8}}%"></view></view>
      <text class="st-week-label">{{item.label}}</text>
    </view>
  </view>

  <view class="section-head">
    <text class="section-title">个人纪录</text>
    <text class="section-meta" wx:if="{{personalRecords.length}}">共 {{personalRecords.length}} 项</text>
  </view>
  <view class="list-card" wx:if="{{topRecords.length}}">
    <view class="list-row st-pr" wx:for="{{topRecords}}" wx:key="key" bindtap="openRecord" data-library-id="{{item.libraryId}}">
      <view class="st-pr-icon"><image class="st-pr-img" src="{{item.image}}" mode="aspectFit" /></view>
      <view class="list-row-body">
        <view class="list-row-title">{{item.name}}</view>
        <view class="st-pr-line"><text class="st-pr-k">最重重量</text><text class="st-pr-v num">{{item.weight}}</text><text class="st-pr-u">kg</text></view>
      </view>
      <view class="st-pr-side">
        <text class="st-pr-k">估算 1RM</text>
        <view><text class="st-pr-v num">{{item.e1rm}}</text><text class="st-pr-u"> kg</text></view>
      </view>
      <image class="chevron" src="/images/icons/chevron-right-grey.svg" />
    </view>
  </view>
  <view class="empty" wx:else>
    <view class="empty-figure"><image class="icon-lg" src="/images/icons/trophy-ink.svg" /></view>
    <view class="empty-title">还没有个人纪录</view>
    <view class="empty-text">完成带重量的训练组后，会自动记录最佳成绩。</view>
  </view>

  <block wx:if="{{distribution.length}}">
    <view class="section-head"><text class="section-title">训练部位分布</text><text class="section-meta">全部记录</text></view>
    <view class="st-dist">
      <view class="st-dist-seg" wx:for="{{distribution}}" wx:key="name" style="flex: {{item.count}}; background: {{item.color}};"></view>
    </view>
    <view class="st-dist-labels">
      <view class="st-dist-label" wx:for="{{distribution}}" wx:key="name" style="flex: {{item.count}};">
        <text class="st-dist-pct num">{{item.percent}}%</text><text class="st-dist-name">{{item.name}}</text>
      </view>
    </view>
  </block>
</view>
