.stats-page {
  padding-bottom: calc(env(safe-area-inset-bottom) + 132rpx);
}

.stats-header {
  padding-bottom: 24rpx;
}

.stats-hero,
.distribution-card,
.completion-card,
.recent-card,
.nutrition-stats-card {
  border: 1rpx solid rgba(217, 232, 228, 0.92);
  box-shadow: 0 10rpx 28rpx rgba(52, 92, 89, 0.08);
}

.stats-hero {
  padding: 30rpx;
  background:
    radial-gradient(circle at top right, rgba(124, 184, 214, 0.18), transparent 34%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(249, 252, 251, 0.96));
}

.hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.hero-copy {
  flex: 1;
  min-width: 0;
}

.hero-kicker {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: var(--text-hint);
}

.hero-title {
  margin-top: 14rpx;
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.35;
}

.hero-subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.8;
}

.hero-highlight {
  min-width: 156rpx;
  padding: 18rpx 18rpx 16rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid rgba(217, 232, 228, 0.92);
  text-align: center;
  box-shadow: 0 10rpx 24rpx rgba(52, 92, 89, 0.06);
}

.hero-highlight-value {
  font-size: 42rpx;
  line-height: 1.1;
  font-weight: 700;
  color: var(--primary-color-strong);
}

.hero-highlight-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-hint);
}

.hero-metrics {
  display: flex;
  gap: 12rpx;
  margin-top: 22rpx;
  flex-wrap: wrap;
}

.hero-metric {
  flex: 1 1 calc(50% - 6rpx);
  min-width: 0;
  padding: 18rpx 14rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.82);
  border: 1rpx solid rgba(217, 232, 228, 0.92);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hero-metric-value {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.hero-metric-label {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: var(--text-hint);
}

.streak-value {
  color: #B17D4C;
}

.rate-value {
  color: #4B8F72;
}

.rest-value {
  color: #5F8B7E;
}

.hero-footnote {
  margin-top: 18rpx;
  font-size: 22rpx;
  color: var(--text-hint);
  line-height: 1.7;
}

.distribution-card,
.completion-card,
.recent-card,
.nutrition-stats-card {
  padding: 28rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(249, 252, 251, 0.96));
}

.stats-card-header {
  margin-bottom: 20rpx;
}

.dist-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.dist-item {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.dist-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.dist-label {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.dist-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.dist-name {
  font-size: 25rpx;
  color: var(--text-primary);
  line-height: 1.6;
}

.dist-count {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-secondary);
}

.dist-track {
  height: 12rpx;
  border-radius: 999rpx;
  background: rgba(217, 232, 228, 0.82);
  overflow: hidden;
}

.dist-fill {
  height: 100%;
  border-radius: inherit;
}

.completion-stats {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.completion-circle {
  flex-shrink: 0;
}

.circle-outer {
  width: 176rpx;
  height: 176rpx;
  padding: 12rpx;
  box-sizing: border-box;
  border-radius: 50%;
  background: conic-gradient(
    #74C093 0%,
    #4EAE7D var(--completion-percent, 0%),
    rgba(217, 232, 228, 0.72) var(--completion-percent, 0%),
    rgba(217, 232, 228, 0.72) 100%
  );
  display: flex;
  align-items: center;
  justify-content: center;
}

.circle-inner {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.circle-value {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--success-color);
}

.circle-label {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--text-hint);
}

.completion-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.completion-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: rgba(244, 248, 247, 0.86);
  border: 1rpx solid rgba(217, 232, 228, 0.92);
}

.completion-key {
  font-size: 23rpx;
  color: var(--text-secondary);
}

.completion-val {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.done-val {
  color: #4B8F72;
}

.undone-val {
  color: #B17D4C;
}

.week-grid {
  display: flex;
  justify-content: space-between;
  gap: 10rpx;
}

.week-day {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 8rpx;
  border-radius: 22rpx;
  background: rgba(244, 248, 247, 0.72);
  border: 1rpx solid rgba(217, 232, 228, 0.82);
}

.week-day-label {
  font-size: 21rpx;
  color: var(--text-hint);
}

.week-day-dot {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: rgba(217, 232, 228, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
}

.week-day-dot.active {
  background: linear-gradient(180deg, #6CC08E, #4EAE7D);
  box-shadow: 0 8rpx 18rpx rgba(78, 174, 125, 0.24);
}

.week-day-dot.rest {
  background: rgba(95, 154, 136, 0.18);
}

.week-day-dot.rest.active {
  background: linear-gradient(180deg, #78B49F, #5F9A88);
  box-shadow: 0 8rpx 18rpx rgba(95, 154, 136, 0.24);
}

.week-day-check {
  font-size: 22rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.week-day-rest {
  font-size: 20rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.week-day-date {
  font-size: 20rpx;
  color: var(--text-hint);
}

.nutrition-day-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(217, 232, 228, 0.72);
}

.nutrition-day-row:last-child {
  border-bottom: none;
}

.nd-date {
  width: 126rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--text-secondary);
  font-weight: 600;
}

.nd-bars {
  flex: 1;
}

.nd-bar-group {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.nd-track {
  flex: 1;
  height: 16rpx;
  border-radius: 999rpx;
  background: rgba(217, 232, 228, 0.82);
  overflow: hidden;
}

.nd-bar {
  height: 100%;
  min-width: 8rpx;
  border-radius: inherit;
  transition: width 0.5s ease;
}

.cal-bar {
  background: linear-gradient(90deg, #E08C8C, #C86464);
}

.nd-bar-label {
  flex-shrink: 0;
  font-size: 20rpx;
  color: var(--text-hint);
  white-space: nowrap;
}

.stats-empty-state {
  padding: 36rpx 0 12rpx;
}

.page-spacer {
  height: 20rpx;
}
