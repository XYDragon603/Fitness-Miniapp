.st-card { padding: 30rpx 24rpx 24rpx; }
.st-top { position: relative; display: flex; align-items: center; justify-content: space-between; padding: 0 12rpx 22rpx; }
.st-label { font-size: 28rpx; }
.st-total { font-size: 120rpx; line-height: 1.05; font-weight: 800; }
.st-total-unit { font-size: 50rpx; }
.st-ring { position: relative; width: 220rpx; height: 220rpx; }
.st-ring-img { width: 220rpx; height: 220rpx; }
.st-ring-center { position: absolute; top: 0; left: 0; right: 0; bottom: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.st-ring-pct { font-size: 52rpx; font-weight: 800; }
.st-ring-sym { font-size: 30rpx; }
.st-ring-label { font-size: 22rpx; color: var(--dark-text-2); }
.st-tiles { display: flex; gap: 16rpx; }
.st-tile { flex: 1; padding: 22rpx 24rpx; }
.st-tile-row { display: flex; align-items: flex-end; justify-content: space-between; margin-top: 8rpx; }
.st-tile-value { font-size: 64rpx; line-height: 1.1; font-weight: 800; }
.st-tile-unit { font-size: 30rpx; }

.st-week { display: flex; gap: 12rpx; padding: 16rpx 16rpx 0; background: var(--surface); border-radius: 22rpx; }
.st-week-col { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.st-week-count { font-size: 24rpx; }
.st-week-track { width: 64rpx; height: 110rpx; display: flex; align-items: flex-end; border-bottom: 2rpx solid var(--line); }
.st-week-bar { width: 100%; border-radius: 8rpx 8rpx 0 0; background: var(--surface-3); }
.st-week-bar.on { background: var(--lime); }
.st-week-label { font-size: 22rpx; color: var(--text-2); padding: 6rpx 0 16rpx; }

.st-pr { gap: 22rpx; }
.st-pr-icon { width: 92rpx; height: 92rpx; border-radius: 18rpx; background: var(--surface-2); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.st-pr-img { width: 80rpx; height: 80rpx; border-radius: 12rpx; }
.st-pr-line { display: flex; align-items: baseline; gap: 10rpx; margin-top: 6rpx; }
.st-pr-k { font-size: 22rpx; color: var(--text-2); }
.st-pr-v { font-size: 40rpx; font-weight: 800; }
.st-pr-u { font-size: 22rpx; color: var(--text-2); }
.st-pr-side { display: flex; flex-direction: column; align-items: flex-start; gap: 2rpx; padding-left: 22rpx; border-left: 2rpx solid var(--line); }

.st-dist { display: flex; height: 36rpx; border-radius: 8rpx; overflow: hidden; gap: 4rpx; }
.st-dist-seg { min-width: 8rpx; }
.st-dist-labels { display: flex; gap: 4rpx; margin-top: 12rpx; }
.st-dist-label { min-width: 70rpx; display: flex; flex-direction: column; align-items: center; }
.st-dist-pct { font-size: 24rpx; font-weight: 800; }
.st-dist-name { font-size: 20rpx; color: var(--text-2); white-space: nowrap; }
