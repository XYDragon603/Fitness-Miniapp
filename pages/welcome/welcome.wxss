.w-top { display: flex; align-items: center; justify-content: space-between; padding: 8rpx 0 12rpx; }
.w-dots { display: flex; gap: 10rpx; }
.w-dot { width: 40rpx; height: 8rpx; border-radius: 4rpx; background: var(--surface-3); }
.w-dot.on { background: var(--ink); }
.w-skip { font-size: 28rpx; color: var(--text-2); padding: 10rpx 0 10rpx 30rpx; }

.w-option { display: flex; align-items: center; min-height: 200rpx; margin-bottom: 18rpx; padding: 30rpx 32rpx; }
.w-option:active { opacity: 0.92; }
.w-option-copy { position: relative; flex: 1; display: flex; flex-direction: column; gap: 8rpx; }
.w-option-title { font-size: 52rpx; font-weight: 800; color: #FFFFFF; }
.w-option-desc { font-size: 26rpx; color: #D6DBDD; }
.w-option-image { position: relative; width: 220rpx; height: 160rpx; flex-shrink: 0; }

.w-level { display: flex; flex-direction: column; gap: 8rpx; padding: 36rpx 32rpx; margin-bottom: 18rpx; border-radius: var(--radius-lg); background: var(--surface); border: 3rpx solid transparent; }
.w-level.active { border-color: var(--ink); background: var(--lime); }
.w-level:active { opacity: 0.9; }
.w-level-title { font-size: 40rpx; font-weight: 800; }
.w-level-desc { font-size: 26rpx; color: var(--text-2); }

.w-info { margin-top: 24rpx; }
.w-info-label { flex: 1; font-size: 31rpx; font-weight: 700; }
.w-info-input { width: 200rpx; text-align: right; font-size: 40rpx; font-weight: 800; }
.w-info-unit { width: 50rpx; font-size: 25rpx; color: var(--text-2); }

.w-plan { min-height: 420rpx; padding: 32rpx; }
.w-plan-badge { position: relative; height: 48rpx; padding: 0 18rpx; border-radius: 10rpx; font-size: 24rpx; font-weight: 800; }
.w-plan-title { position: relative; margin-top: 18rpx; padding-right: 250rpx; font-size: 50rpx; line-height: 1.25; font-weight: 800; }
.w-plan-meta { position: relative; margin-top: 8rpx; font-size: 28rpx; color: #D6DBDD; }
.w-plan-image { position: absolute; right: 16rpx; top: 60rpx; width: 250rpx; height: 190rpx; }
.w-plan-days { position: relative; display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 40rpx; }
.w-plan-day { width: 104rpx; height: 100rpx; border-radius: 16rpx; background: var(--dark-2); border: 2rpx solid var(--dark-line); display: flex; flex-direction: column; align-items: center; justify-content: center; }
.w-plan-day-no { font-size: 20rpx; color: var(--dark-text-2); }
.w-plan-day-focus { font-size: 26rpx; font-weight: 800; color: #FFFFFF; max-width: 96rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }

.w-note { margin-top: 24rpx; font-size: 25rpx; color: var(--text-2); }
.w-back { margin-top: 32rpx; text-align: center; font-size: 27rpx; color: var(--text-2); }
